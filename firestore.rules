rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    /**
     * O login corporativo é a chave funcional — derivado do e-mail
     * autenticado, do mesmo jeito que o app faz (fulano@empresa.com ->
     * fulano). Não depende de custom claims, de Admin SDK nem de
     * usuarios/{request.auth.uid}: funciona igual para login por senha hoje
     * e para um provedor OAuth corporativo (ex.: Microsoft) no futuro,
     * contanto que ele devolva e-mail.
     */
    function loginDoAuth() {
      return request.auth.token.email.lower().split('@')[0];
    }

    function eu() {
      return get(
        /databases/$(database)/documents/usuarios/$(loginDoAuth())
      ).data;
    }

    function minhaEquipe() {
      return eu().equipeId;
    }

    /**
     * Espelha `perfilEfetivo()` de lib/sessao.ts. `.get(chave, default)` é
     * obrigatório — acessar `usuarioDoc.perfil` direto em documento legado
     * sem o campo é erro de avaliação em Rules (não `null`), o que
     * reprovaria a expressão inteira para TODO usuário existente.
     */
    function perfilDe(usuarioDoc) {
      return usuarioDoc.get('perfil', null) != null
        ? usuarioDoc.perfil
        : (usuarioDoc.nivelHierarquico <= 5 ? 'GESTOR_EQUIPE' : 'ANALISTA_SOC');
    }

    function meuPerfil() {
      return perfilDe(eu());
    }

    function souAdminSistema() {
      return autenticado() && meuPerfil() == 'ADMIN_SISTEMA';
    }

    /**
     * Mantido com o mesmo nome para não obrigar reescrever toda regra que já
     * chama souGestor() — agora também é true para ADMIN_SISTEMA, que herda
     * todo poder de gestor mais o cross-equipe de podeOperarNaEquipe().
     *
     * PATCH-NOC-SUPERVISAO-CONSULTA-PLANTAO-UX-1 — `SUPERVISOR_EQUIPE` tem o
     * MESMO alcance operacional de `GESTOR_EQUIPE` sobre a própria equipe
     * (ver comentário de `PerfilUsuario` em `lib/modelos.ts`: nomes
     * distintos só refletem o cargo real na hierarquia, nunca um poder
     * menor). Toda regra que compõe `souGestor()` já limita o escopo por
     * fora (`podeOperarNaEquipe()`, `resource.data.equipeId == minhaEquipe()`,
     * `escopoDoGrupoPlantaoNoMeuAlcance()`) — incluir `SUPERVISOR_EQUIPE`
     * aqui nunca abre acesso cross-equipe, só remove a restrição artificial
     * que exigia `GESTOR_EQUIPE` para ações que a supervisão da própria
     * equipe já deveria poder fazer (ex.: aprovar/recusar Troca de Jornada).
     */
    function souGestor() {
      return autenticado() && (meuPerfil() in ['GESTOR_EQUIPE', 'SUPERVISOR_EQUIPE'] || souAdminSistema());
    }

    function souResponsavelOperacionalElegivel() {
      return autenticado()
        && meuPerfil() in ['ADMIN_SISTEMA', 'GESTOR_UNIDADE', 'GESTOR_EQUIPE', 'SUPERVISOR_EQUIPE'];
    }

    /**
     * STAGING-RESET-HIERARQUIA-ICI-1 — liberação operacional exclusiva de
     * homologação. `config/ambiente` só existe (com `staging: true`) em
     * bases de staging, escrito unicamente pelo Admin SDK do script de seed
     * (`scripts/staging/seed-hierarquia-ici.mjs`) — a rule de
     * `config/{doc}` abaixo já nega toda escrita client (`allow write: if
     * false`), então nenhum usuário autenticado consegue criar esse
     * documento sozinho, em nenhum ambiente. Ausência do documento (toda
     * base de produção, e staging antes do seed rodar) faz
     * `ambienteEhStaging()` avaliar `false` — fail-closed, comportamento
     * idêntico ao de antes desta fase. Produção nunca depende desta flag:
     * na ausência do doc (ou com `staging: false`), o comportamento é
     * exatamente o pré-existente.
     *
     * `souCoordenadorOperacionalStaging()` NUNCA deve ser usada para
     * afrouxar: criação/promoção de ADMIN_SISTEMA, escopo GLOBAL, ou
     * qualquer delete físico já negado com `if false` (auditoria, histórico,
     * publicações) — essas regras continuam intocadas por esta fase.
     */
    function ambienteEhStaging() {
      return exists(/databases/$(database)/documents/config/ambiente)
        && get(/databases/$(database)/documents/config/ambiente).data.get('staging', false) == true;
    }

    function souCoordenadorOperacionalStaging() {
      return autenticado()
        && ambienteEhStaging()
        && meuPerfil() in ['ADMIN_SISTEMA', 'GESTOR_UNIDADE', 'GESTOR_EQUIPE', 'SUPERVISOR_EQUIPE'];
    }

    /**
     * Espelha `equipesPermitidasEfetivas()` de lib/sessao.ts: lista explícita
     * (não-vazia) manda; na ausência, `equipeId` (sempre presente) vira lista
     * implícita de 1 elemento — é o que mantém todo GESTOR_EQUIPE/
     * ANALISTA_SOC existente funcionando sem qualquer migração de dado, sem
     * precisar setar `equipesPermitidas` explicitamente.
     */
    function minhasEquipesPermitidas() {
      return eu().get('equipesPermitidas', []).size() > 0
        ? eu().equipesPermitidas
        : [eu().equipeId];
    }

    /**
     * Substitui toda comparação "X.equipeId == minhaEquipe()" espalhada pelo
     * arquivo: admin sempre passa, independente da equipe do documento;
     * qualquer outro perfil só passa se `equipeId` estiver em
     * `minhasEquipesPermitidas()` — que já cobre o caso de hoje (uma única
     * equipe, via fallback) e também um GESTOR_EQUIPE/SUPERVISOR_EQUIPE com
     * `equipesPermitidas` explícito cobrindo mais de uma equipe.
     */
    function podeOperarNaEquipe(equipeId) {
      return autenticado() && (souAdminSistema() || equipeId in minhasEquipesPermitidas());
    }

    /**
     * Espelha `unidadesPermitidasEfetivas()` de lib/sessao.ts: lista
     * explícita (não-vazia) manda; na ausência, `unidadeId` único vira lista
     * implícita de 1 elemento; sem nenhum dos dois, lista vazia. `.get(chave,
     * default)` é obrigatório pelo mesmo motivo de `perfilDe()` — documento
     * legado sem o campo não pode virar erro de avaliação.
     */
    function minhasUnidadesPermitidas() {
      return eu().get('unidadesPermitidas', []).size() > 0
        ? eu().unidadesPermitidas
        : (eu().get('unidadeId', null) != null ? [eu().unidadeId] : []);
    }

    function souGestorUnidade() {
      return autenticado() && meuPerfil() == 'GESTOR_UNIDADE';
    }

    /**
     * NÃO percorre `parentId`/árvore de unidades — só checa se `unidadeId`
     * está literalmente em `minhasUnidadesPermitidas()` (array explícito).
     * ADMIN_SISTEMA sempre passa.
     */
    function podeOperarNaUnidade(unidadeId) {
      return autenticado()
        && (souAdminSistema() || (souGestorUnidade() && unidadeId in minhasUnidadesPermitidas()));
    }

    /**
     * Fase ESCOPO-GESTOR-UNIDADE-1 — variante de `podeOperarNaUnidade()` que
     * também aceita subárvore: além do match exato, aceita quando `caminho`
     * (o caminho materializado raiz -> nó, calculado uma única vez na
     * criação — NUNCA travessia de `parentId` em tempo de leitura) contém
     * alguma unidade permitida como ancestral. Usada só onde o documento já
     * carrega esse caminho materializado (`Equipe.caminhoUnidade`,
     * `GrupoPlantao.caminhoUnidadeResponsavel`) — nunca substitui
     * `podeOperarNaUnidade()`, que continua a checagem canônica de match
     * exato usada por `unidadesOrganizacionais` (ver
     * `docs/spec/ESCOPO_OPERACIONAL_GESTOR_UNIDADE.md`).
     */
    function podeOperarNaUnidadeOuDescendente(unidadeId, caminho) {
      return podeOperarNaUnidade(unidadeId)
        || (autenticado() && souGestorUnidade() && caminho is list && caminho.hasAny(minhasUnidadesPermitidas()));
    }

    /**
     * Busca o documento real de outro usuário por login — usado só para
     * validar o destinatário verdadeiro de um Lembrete Atribuído. Nunca
     * confiar em `destinatarioEquipeId` do payload do cliente sem checar
     * contra o `equipeId` real deste documento (ver `lembretesAtribuidos`
     * abaixo) — fecha o ataque de enviar o login de alguém de uma equipe
     * junto com o `destinatarioEquipeId` de outra equipe (a que o gestor
     * efetivamente administra) para tentar burlar o escopo.
     */
    function usuarioPorLogin(login) {
      return get(/databases/$(database)/documents/usuarios/$(login)).data;
    }

    /**
     * Plantão (Fase PLANTÃO-3A, docs/spec/PLANTOES.md seção 20) — domínio
     * paralelo à escala 6x1, nunca misturado com `turnosMes`/`usuarios`.
     * Helpers de autorização espelhados 1:1 em
     * `lib/modelosPlantao`/`lib/sessao.ts`-style: qualquer mudança aqui
     * exige a mudança gêmea lá, mesmo princípio de `perfilDe()`/
     * `minhasEquipesPermitidas()` acima.
     */
    function grupoPlantaoPorId(grupoId) {
      return get(/databases/$(database)/documents/gruposPlantao/$(grupoId)).data;
    }

    /**
     * `equipesConsulta` é gravado SEMPRE não vazio e SEMPRE contendo
     * `equipeResponsavelId` (garantido por `equipesConsultaEfetivas()` no
     * cliente e revalidado na escrita, abaixo) — diferente de
     * `equipesPermitidas`/`unidadesPermitidas` de `usuarios`, aqui não há
     * fallback em tempo de leitura porque Plantão é domínio novo, sem
     * documento legado a preservar.
     */
    function podeConsultarGrupoPlantao(grupoDoc) {
      return autenticado()
        && (souAdminSistema() || minhaEquipe() in grupoDoc.equipesConsulta);
    }

    /**
     * Administrar (criar/editar Grupo, participantes, contatos, rascunho)
     * exige SER GESTOR (não só pertencer à equipe — um analista comum da
     * própria equipe responsável não administra nada só por participar do
     * grupo, ver seção "Participante do Grupo") E ter poder sobre a EQUIPE
     * RESPONSÁVEL especificamente — nunca basta estar entre as equipes que
     * só consultam (SOC/NOC podem consultar o Plantão de Segurança sem
     * poder administrá-lo). Mesma composição `souGestor() &&
     * podeOperarNaEquipe(...)` que toda regra de escrita 6x1 já usa
     * (`turnosMes`/`rascunhosTurnosMes` acima) — `podeOperarNaEquipe()`
     * sozinha só verifica pertencimento à equipe, não perfil.
     *
     * Fase ESCOPO-GESTOR-UNIDADE-1 (`docs/spec/ESCOPO_OPERACIONAL_GESTOR_UNIDADE.md`)
     * — mudança de regra aprovada: até esta fase, `GESTOR_UNIDADE` NUNCA
     * administrava Plantão, mesmo sendo coordenador da unidade dona da
     * equipe responsável. Agora, um segundo caminho de autorização (OR,
     * nunca substituindo o primeiro) aceita `GESTOR_UNIDADE` quando o
     * Grupo carrega `unidadeResponsavelId` (campo opcional/retrocompatível
     * de `GrupoPlantao`, `@escala-ici/contrato`) dentro de
     * `unidadesPermitidas` — ou de uma unidade ANCESTRAL, via
     * `caminhoUnidadeResponsavel` materializado (nunca travessia de
     * `parentId`). Um Grupo antigo sem esse campo simplesmente não é
     * administrável por nenhum `GESTOR_UNIDADE` — só pelo
     * `GESTOR_EQUIPE`/`ADMIN_SISTEMA` de sempre, o mesmo comportamento de
     * antes desta fase (retrocompatibilidade real, não só de schema).
     */
    /**
     * Extraído de `podeGerenciarGrupoPlantao()` para ser reutilizado pela
     * liberação de staging (STAGING-RESET-HIERARQUIA-ICI-1) sem duplicar a
     * checagem de unidade/caminho ancestral: aqui só o ESCOPO (equipe ou
     * unidade responsável) é avaliado, sem checar perfil — quem chama decide
     * qual perfil autoriza (`souGestor()`/`souGestorUnidade()` abaixo, ou
     * `souCoordenadorOperacionalStaging()` nas regras de staging).
     */
    function escopoDoGrupoPlantaoNoMeuAlcance(grupoDoc) {
      return podeOperarNaEquipe(grupoDoc.equipeResponsavelId)
        || (
          grupoDoc.get('unidadeResponsavelId', null) != null
          && (
            grupoDoc.unidadeResponsavelId in minhasUnidadesPermitidas()
            || (
              grupoDoc.get('caminhoUnidadeResponsavel', []) is list
              && grupoDoc.get('caminhoUnidadeResponsavel', []).hasAny(minhasUnidadesPermitidas())
            )
          )
        );
    }

    function podeGerenciarGrupoPlantao(grupoDoc) {
      return (souGestor() && escopoDoGrupoPlantaoNoMeuAlcance(grupoDoc))
        || (souGestorUnidade() && grupoDoc.get('unidadeResponsavelId', null) != null && escopoDoGrupoPlantaoNoMeuAlcance(grupoDoc))
        // STAGING-RESET-HIERARQUIA-ICI-1 — em staging, SUPERVISOR_EQUIPE
        // também administra Grupo de Plantão dentro do próprio escopo,
        // mesmo sem ser "gestor" no sentido legado (souGestor()).
        || (souCoordenadorOperacionalStaging() && escopoDoGrupoPlantaoNoMeuAlcance(grupoDoc));
    }

    /**
     * Fase ESCOPO-CONSULTA-PLANTAO-1
     * (`docs/spec/ESCOPO_OPERACIONAL_GESTOR_UNIDADE.md`, seção "Plantões
     * monitorados por equipe") — autovínculo de CONSULTA: um
     * `GESTOR_EQUIPE`/`SUPERVISOR_EQUIPE` pode adicionar ou remover a
     * PRÓPRIA equipe administrada em `equipesConsulta` de um Grupo que ele
     * NÃO administra (ex.: a supervisora do NOC vinculando o NOC ao
     * Plantão de outra coordenação) — sem depender de
     * `podeGerenciarGrupoPlantao()`, que continua exigindo poder sobre a
     * equipe/unidade RESPONSÁVEL, nunca sobre a equipe consultante.
     *
     * Nunca abre write genérico: exige que a mudança entre `antigo` e
     * `novo` seja EXATAMENTE uma equipe adicionada OU removida (nunca as
     * duas ao mesmo tempo, nunca mais de uma), que essa equipe esteja em
     * `minhasEquipesPermitidas()` (nunca a de terceiros), e que
     * `equipeResponsavelId` nunca saia de `equipesConsulta` — mesmo que o
     * usuário também tivesse permissão sobre a equipe responsável (ver
     * "GESTOR_EQUIPE com equipesPermitidas explícito" nos testes).
     * `ADMIN_SISTEMA` não precisa deste caminho — já tem o `update` livre
     * via `podeGerenciarGrupoPlantao()`.
     */
    function podeAutoVincularConsultaPlantao(antigo, novo, equipeResponsavelId) {
      return autenticado()
        && meuPerfil() in ['GESTOR_EQUIPE', 'SUPERVISOR_EQUIPE']
        && equipeResponsavelId in novo
        && (novo.removeAll(antigo).size() + antigo.removeAll(novo).size()) == 1
        && (
          (novo.removeAll(antigo).size() == 1 && novo.removeAll(antigo)[0] in minhasEquipesPermitidas())
          || (antigo.removeAll(novo).size() == 1 && antigo.removeAll(novo)[0] in minhasEquipesPermitidas())
        );
    }

    /** Até 3 contatos por plantonista; cada um com rótulo/número não vazios e sem campo extra. */
    function contatoPlantonistaValido(contato) {
      return contato.keys().hasOnly(['rotulo', 'numero', 'ativo'])
        && contato.rotulo is string && contato.rotulo.size() > 0 && contato.rotulo.size() <= 40
        && contato.numero is string && contato.numero.size() > 0 && contato.numero.size() <= 30
        && contato.ativo is bool;
    }

    function contatosPlantonistaValidos(contatos) {
      return contatos is list
        && contatos.size() <= 3
        && (contatos.size() < 1 || contatoPlantonistaValido(contatos[0]))
        && (contatos.size() < 2 || contatoPlantonistaValido(contatos[1]))
        && (contatos.size() < 3 || contatoPlantonistaValido(contatos[2]));
    }

    /**
     * FASE-PLANTAO-POS-PUBLICACAO-APP-VISUALIZACAO-2 — índice (0..7) na
     * MESMA paleta categórica de 8 cores já usada pelo calendário do
     * Editor (`indiceIdentidadePlantonista()`/`TAMANHO_PALETA_IDENTIDADE_PLANTAO`,
     * `lib/editorPlantao.ts` + `app/globals.css`), escolhido pelo próprio
     * plantonista no App para se identificar mais fácil no calendário
     * mensal. Campo OPCIONAL — ausência é válida (cai no hash automático).
     * Nunca uma cor livre/hex: restringir a um índice fixo garante que todo
     * valor gravado corresponde a uma cor com contraste já validado.
     */
    function corPlantonistaPreferidaValida(cor) {
      return cor == null || (cor is int && cor >= 0 && cor <= 7);
    }

    /**
     * Fase PLANTAO-PADRAO-1 — uma entrada do padrão semanal de um Grupo de
     * Plantão. Valida estrutura/tipos/faixas (mesmo nível das outras Rules
     * deste arquivo, ex. `duracaoMinutos > 0` em atribuições, que também
     * não recalcula fim-início) — NÃO valida duplicidade de `diaSemana`
     * entre elementos (exigiria comparação par-a-par de até 7 posições,
     * desproporcional ao ganho de defesa real já coberto pela validação
     * client-side, `validarPadraoHorarioSemanal()`, que roda antes de
     * qualquer escrita). `horaInicio`/`horaFim` no formato `HH:mm` (00–23/
     * 00–59); `fimDiaOffset` só 0 ou 1.
     */
    function padraoHorarioPlantaoDiaValido(entrada) {
      return entrada.keys().hasOnly(['diaSemana', 'horaInicio', 'horaFim', 'fimDiaOffset'])
        && entrada.diaSemana is int && entrada.diaSemana >= 0 && entrada.diaSemana <= 6
        && entrada.horaInicio is string && entrada.horaInicio.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && entrada.horaFim is string && entrada.horaFim.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && entrada.fimDiaOffset is int && entrada.fimDiaOffset in [0, 1];
    }

    /** Até 7 entradas (uma por dia da semana) — array vazio é válido (nenhum padrão configurado). */
    function padraoHorarioSemanalValido(padrao) {
      return padrao is list
        && padrao.size() <= 7
        && (padrao.size() < 1 || padraoHorarioPlantaoDiaValido(padrao[0]))
        && (padrao.size() < 2 || padraoHorarioPlantaoDiaValido(padrao[1]))
        && (padrao.size() < 3 || padraoHorarioPlantaoDiaValido(padrao[2]))
        && (padrao.size() < 4 || padraoHorarioPlantaoDiaValido(padrao[3]))
        && (padrao.size() < 5 || padraoHorarioPlantaoDiaValido(padrao[4]))
        && (padrao.size() < 6 || padraoHorarioPlantaoDiaValido(padrao[5]))
        && (padrao.size() < 7 || padraoHorarioPlantaoDiaValido(padrao[6]));
    }

    /** Campo opcional: ausente é válido (retrocompatibilidade — documentos antigos nunca têm o campo). */
    function padraoHorarioSemanalDoRequestValido(dados) {
      return !('padraoHorarioSemanal' in dados) || padraoHorarioSemanalValido(dados.padraoHorarioSemanal);
    }

    function escopoOperacionalValido(dados) {
      return dados.keys().hasOnly([
          'tipo', 'alvoId', 'alvoNome', 'unidadeId', 'caminhoUnidade',
          'responsaveisLogin', 'responsaveisEquipe', 'equipesConsulta',
          'ativo', 'criadoEm', 'atualizadoEm', 'criadoPorLogin',
          'atualizadoPorLogin', 'schemaVersion',
        ])
        && dados.tipo in ['JORNADA', 'PLANTAO']
        && dados.alvoId is string && dados.alvoId.size() > 0
        && dados.alvoNome is string && dados.alvoNome.size() > 0
        && (!('unidadeId' in dados) || dados.unidadeId is string)
        && (!('caminhoUnidade' in dados) || dados.caminhoUnidade is list)
        && dados.responsaveisLogin is list
        && dados.responsaveisEquipe is list
        && dados.equipesConsulta is list
        && (dados.responsaveisLogin.size() > 0 || dados.responsaveisEquipe.size() > 0)
        && (dados.tipo == 'PLANTAO' || dados.equipesConsulta.size() == 0)
        && dados.ativo is bool
        && dados.criadoPorLogin is string && dados.criadoPorLogin.size() > 0
        && dados.atualizadoPorLogin is string && dados.atualizadoPorLogin.size() > 0
        && dados.schemaVersion in [1];
    }

    /**
     * ESCOPO-OPERACIONAL-MATRIZ-2 — autorização operacional por alvo.
     * O ID canônico é o mesmo de `criarIdEscopoOperacional()` no cliente.
     * `equipesConsulta` participa somente de leitura; nunca entra no helper
     * de administração.
     */
    function idEscopoOperacional(tipo, alvoId) {
      return tipo + '_' + alvoId;
    }

    function existeMatrizOperacional(tipo, alvoId) {
      return exists(/databases/$(database)/documents/escoposOperacionais/$(idEscopoOperacional(tipo, alvoId)));
    }

    function matrizOperacional(tipo, alvoId) {
      return get(/databases/$(database)/documents/escoposOperacionais/$(idEscopoOperacional(tipo, alvoId))).data;
    }

    function matrizConcedeAdministracao(tipo, alvoId) {
      return autenticado()
        && existeMatrizOperacional(tipo, alvoId)
        && matrizOperacional(tipo, alvoId).ativo == true
        && matrizOperacional(tipo, alvoId).tipo == tipo
        && matrizOperacional(tipo, alvoId).alvoId == alvoId
        && (
          loginDoAuth() in matrizOperacional(tipo, alvoId).responsaveisLogin
          || matrizOperacional(tipo, alvoId).responsaveisEquipe.hasAny(minhasEquipesPermitidas())
        );
    }

    function matrizConcedeConsultaPlantao(grupoId) {
      return autenticado()
        && existeMatrizOperacional('PLANTAO', grupoId)
        && matrizOperacional('PLANTAO', grupoId).ativo == true
        && matrizOperacional('PLANTAO', grupoId).tipo == 'PLANTAO'
        && matrizOperacional('PLANTAO', grupoId).alvoId == grupoId
        && matrizOperacional('PLANTAO', grupoId).equipesConsulta.hasAny(minhasEquipesPermitidas());
    }

    function podeAdministrarJornada(equipeId) {
      return souAdminSistema()
        || matrizConcedeAdministracao('JORNADA', equipeId)
        // Transição: alvos ainda sem documento de matriz conservam a ACL
        // histórica. Assim que a matriz existe (mesmo inativa), ela manda.
        || (!existeMatrizOperacional('JORNADA', equipeId) && souGestor() && podeOperarNaEquipe(equipeId))
        // STAGING-RESET-HIERARQUIA-ICI-1 — em staging, a Matriz ajuda a
        // navegação mas NUNCA trava um coordenador/supervisor dentro do
        // próprio escopo, mesmo que exista (e não o liste) ou esteja
        // inativa. Deliberadamente FORA do `!existeMatrizOperacional(...)`
        // acima — é exatamente o caso que essa branch não cobre.
        || (souCoordenadorOperacionalStaging() && podeOperarNaEquipe(equipeId));
    }

    function podeAdministrarEscalaPlantao(grupoId) {
      return souAdminSistema()
        || matrizConcedeAdministracao('PLANTAO', grupoId)
        // Mesmo fallback transitório, restrito a alvos sem matriz.
        || (!existeMatrizOperacional('PLANTAO', grupoId) && podeGerenciarGrupoPlantao(grupoPlantaoPorId(grupoId)))
        // STAGING-RESET-HIERARQUIA-ICI-1 — mesmo raciocínio de
        // podeAdministrarJornada(): liberação de staging fica FORA do
        // `!existeMatrizOperacional(...)`, para não ser bloqueada por uma
        // Matriz existente que não lista o coordenador de teste.
        || (souCoordenadorOperacionalStaging() && escopoDoGrupoPlantaoNoMeuAlcance(grupoPlantaoPorId(grupoId)));
    }

    /**
     * Contexto auditável enviado no cadastro de uma pessoa. Resolve a lacuna
     * entre `usuarios.equipeId` e um alvo PLANTAO: o responsável só pode
     * cadastrar na equipe responsável do Grupo que ele realmente administra.
     */
    function contextoCadastroOperacionalAutorizaUsuario(dados, exigirMesmoAutor) {
      let contexto = dados.get('cadastroOperacional', null);
      return souResponsavelOperacionalElegivel()
        && contexto is map
        && contexto.keys().hasOnly(['tipo', 'alvoId', 'criadoPorLogin'])
        && contexto.tipo in ['JORNADA', 'PLANTAO']
        && contexto.alvoId is string && contexto.alvoId.size() > 0
        && (!exigirMesmoAutor || contexto.criadoPorLogin == loginDoAuth())
        && (
          (
            contexto.tipo == 'JORNADA'
            && contexto.alvoId == dados.equipeId
            && podeAdministrarJornada(contexto.alvoId)
          )
          || (
            contexto.tipo == 'PLANTAO'
            && exists(/databases/$(database)/documents/gruposPlantao/$(contexto.alvoId))
            && grupoPlantaoPorId(contexto.alvoId).ativo == true
            && grupoPlantaoPorId(contexto.alvoId).equipeResponsavelId == dados.equipeId
            && podeAdministrarEscalaPlantao(contexto.alvoId)
          )
        );
    }

    function perfilCadastroPorResponsavelValido(dados) {
      return (
          dados.get('perfil', null) == null
          && dados.get('escopo', null) == null
          && dados.nivelHierarquico > 5
        )
        || (
          dados.get('cadastroOperacional', null) != null
          && dados.get('perfil', null) in ['GESTOR_EQUIPE', 'SUPERVISOR_EQUIPE']
          && dados.get('escopo', null) == 'EQUIPE'
          && dados.nivelHierarquico >= 1
          && dados.nivelHierarquico <= 5
        );
    }

    /**
     * STAGING-RESET-HIERARQUIA-ICI-2 — cadastro livre de unidade/equipe por
     * coordenador em staging: diferente de `perfilCadastroPorResponsavelValido()`
     * (que exige `cadastroOperacional` apontando para um alvo que o
     * responsável já administra via Matriz/ACL), esta função NUNCA checa se
     * quem cadastra administra a unidade/equipe escolhida — só valida a
     * COMBINAÇÃO perfil/escopo/unidade/equipe em si, para nunca travar o
     * coordenador numa lista incompleta de unidades/equipes conhecidas.
     *
     * Ainda assim, `ADMIN_SISTEMA` e escopo `GLOBAL` continuam
     * estruturalmente impossíveis por aqui (enumeração fechada, igual a
     * `perfilCadastroPorResponsavelValido()`).
     */
    function perfilCadastroLivreStagingValido(dados) {
      return (
          dados.get('perfil', null) == null
          && dados.get('escopo', null) == null
        )
        || (
          dados.get('perfil', null) == 'GESTOR_UNIDADE'
          && dados.get('escopo', null) == 'UNIDADE'
          && dados.get('unidadeId', null) is string && dados.unidadeId.size() > 0
          && dados.get('unidadesPermitidas', []) is list && dados.unidadesPermitidas.size() > 0
        )
        || (
          dados.get('perfil', null) in ['GESTOR_EQUIPE', 'SUPERVISOR_EQUIPE']
          && dados.get('escopo', null) == 'EQUIPE'
          && dados.equipeId is string && dados.equipeId.size() > 0
          && dados.get('equipesPermitidas', []) is list && dados.equipesPermitidas.size() > 0
        );
    }

    function podeLerEscalaPlantao(grupoId) {
      return podeAdministrarEscalaPlantao(grupoId)
        || matrizConcedeConsultaPlantao(grupoId)
        // A ACL histórica só é fallback enquanto o alvo não foi migrado.
        // Uma matriz existente, mesmo inativa, é a fonte de verdade e não
        // pode ser contornada por `gruposPlantao.equipesConsulta`.
        || (!existeMatrizOperacional('PLANTAO', grupoId) && podeConsultarGrupoPlantao(grupoPlantaoPorId(grupoId)));
    }

    /**
     * FASE-TROCAS-PLANTAO-1 — participação ATIVA no Grupo é o que autoriza
     * pedir/responder uma troca de Plantão (nunca `minhaEquipe()`: um
     * participante pode ser de outra equipe, e um colega de equipe pode não
     * ser plantonista). `exists()` antes de `get()` é obrigatório aqui: em
     * Firestore Rules, `get()` sobre um documento inexistente é ERRO DE
     * AVALIAÇÃO (não `null`), o que reprovaria a expressão inteira — mesmo
     * cuidado já tomado em `competenciasPlantao` (comentário acima).
     */
    function participanteAtivoDoGrupoPlantao(grupoId, login) {
      return exists(/databases/$(database)/documents/gruposPlantao/$(grupoId)/participantes/$(login))
        && get(/databases/$(database)/documents/gruposPlantao/$(grupoId)/participantes/$(login)).data.ativo == true;
    }

    function souParticipanteAtivoDoGrupoPlantao(grupoId) {
      return autenticado() && participanteAtivoDoGrupoPlantao(grupoId, loginDoAuth());
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /usuarios/{login} {
      allow read: if autenticado()
        && (
          loginDoAuth() == login
          || podeOperarNaEquipe(resource.data.equipeId)
          // O responsável operacional precisa enumerar os usuários do alvo
          // para montar a grade de Jornada, mesmo pertencendo a outra equipe.
          || matrizConcedeAdministracao('JORNADA', resource.data.equipeId)
          // Pessoas cadastradas a partir de Plantão carregam o contexto do
          // Grupo. Responsáveis atuais do mesmo alvo conseguem relê-las sem
          // ganhar acesso aos usuários de outras equipes.
          || contextoCadastroOperacionalAutorizaUsuario(resource.data, false)
          // PATCH-PLANTAO-VINCULO-GESTOR-COMO-PARTICIPANTE-1 — espelha
          // `podeOperarNaEquipe()` acima, mas pela UNIDADE do próprio
          // documento lido: um GESTOR_UNIDADE precisa encontrar, como
          // candidato a participante de Plantão, alguém cujo cadastro
          // aponte a mesma unidade que ele administra (`unidadeId`), mesmo
          // que a equipe dessa pessoa seja outra (ex.: um coordenador cuja
          // equipe é a de Jornada, mas que também é GESTOR_UNIDADE da
          // mesma unidade responsável pelo Plantão). Só o campo `unidadeId`
          // do próprio documento é usado — nunca amplia para outra equipe
          // nem outra unidade fora do que `minhasUnidadesPermitidas()` já
          // autoriza em todo o restante do arquivo.
          || (souGestorUnidade() && resource.data.get('unidadeId', null) != null && resource.data.unidadeId in minhasUnidadesPermitidas())
        );

      allow update: if autenticado()
        && (
          // autoatualização: só `nome`, como hoje — perfil/escopo nunca no
          // payload (nem para "reafirmar" o valor atual).
          (
            loginDoAuth() == login
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['nome'])
          )

          // admin: qualquer campo, qualquer equipe, inclusive perfil/escopo
          // e realocação de equipe — só `login` (o campo) fica imutável.
          || (
            souAdminSistema()
            && request.resource.data.login == resource.data.login
          )

          // Na importação da Jornada, o responsável do alvo pode apenas
          // reconciliar os aliases da planilha. Isso não vira permissão de
          // administração geral do cadastro do usuário.
          || (
            !souAdminSistema()
            && (
              matrizConcedeAdministracao('JORNADA', resource.data.equipeId)
              || contextoCadastroOperacionalAutorizaUsuario(resource.data, false)
            )
            && request.resource.data.equipeId == resource.data.equipeId
            && request.resource.data.login == resource.data.login
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['aliasesPlanilha', 'atualizadoEm'])
          )

          // gestor não-admin: exatamente como hoje (equipeId/login
          // imutáveis), MAIS a trava nova — não pode tocar perfil, escopo,
          // nem os campos do modelo organizacional flexível
          // (unidadeId/unidadesPermitidas/equipesPermitidas) de ninguém,
          // nem do próprio time.
          || (
            souGestor()
            && !souAdminSistema()
            && resource.data.equipeId == minhaEquipe()
            && request.resource.data.equipeId == resource.data.equipeId
            && request.resource.data.login == resource.data.login
            && request.resource.data.get('perfil', null) == resource.data.get('perfil', null)
            && request.resource.data.get('escopo', null) == resource.data.get('escopo', null)
            && request.resource.data.get('unidadeId', null) == resource.data.get('unidadeId', null)
            && request.resource.data.get('unidadesPermitidas', null) == resource.data.get('unidadesPermitidas', null)
            && request.resource.data.get('equipesPermitidas', null) == resource.data.get('equipesPermitidas', null)
            && request.resource.data.get('cadastroOperacional', null) == resource.data.get('cadastroOperacional', null)
          )
        );

      allow create: if autenticado()
        && request.resource.data.login == login
        && (
          // admin cria em qualquer equipe, com qualquer perfil/escopo/campo
          // organizacional — inclusive um novo ADMIN_SISTEMA.
          souAdminSistema()

          || (
            !souAdminSistema()
            && (
              contextoCadastroOperacionalAutorizaUsuario(request.resource.data, true)
              // Compatibilidade com clientes anteriores: cadastro comum de
              // colaborador em Jornada continua válido sem o metadado novo.
              || (
                request.resource.data.get('cadastroOperacional', null) == null
                && podeAdministrarJornada(request.resource.data.equipeId)
              )
            )
            // Coordenação/supervisão pode ser delegada apenas com contexto
            // explícito do alvo e escopo EQUIPE. Gestão global/de unidade
            // permanece exclusiva do ADMIN_SISTEMA.
            && perfilCadastroPorResponsavelValido(request.resource.data)
            && request.resource.data.get('unidadeId', null) == null
            && request.resource.data.get('unidadesPermitidas', null) == null
            && request.resource.data.get('equipesPermitidas', null) == null
          )

          // STAGING-RESET-HIERARQUIA-ICI-2 — cadastro livre de unidade/equipe:
          // deliberadamente NÃO exige `contextoCadastroOperacionalAutorizaUsuario()`
          // nem `podeAdministrarJornada()` sobre o alvo escolhido (isso é
          // exatamente o que travava o coordenador numa lista incompleta de
          // unidades/equipes). `cadastroOperacional` fica de fora (metadado da
          // delegação via Matriz, sem sentido aqui) — a auditoria desta ação
          // vem de `registrarAuditoriaOperacional()`, não deste campo.
          || (
            souCoordenadorOperacionalStaging()
            && request.resource.data.get('cadastroOperacional', null) == null
            && perfilCadastroLivreStagingValido(request.resource.data)
          )
        );

      allow delete: if souAdminSistema();
    }

    /**
     * Lembretes pessoais — subcoleção de `usuarios/{login}`, NÃO um campo
     * dentro do documento `usuarios/{login}` em si: esta rule é totalmente
     * independente da rule acima (afrouxar uma não afrouxa a outra).
     * Privacidade é estrutural — a condição de acesso é só `loginDoAuth()
     * == login` (o segmento do PATH, não um campo de `resource.data`), então
     * um `list` sem filtro nenhum já é seguro por natureza: a consulta só
     * pode enumerar a subcoleção de UM login por vez, nunca "todas as
     * subcoleções de lembretes de todos os usuários" via client SDK comum.
     * Nem `souGestor()` nem `souAdminSistema()` têm qualquer exceção aqui —
     * administrar usuários não implica acesso a conteúdo pessoal.
     */
    match /usuarios/{login}/lembretes/{lembreteId} {
      allow read: if autenticado() && loginDoAuth() == login;

      allow create: if autenticado()
        && loginDoAuth() == login
        && request.resource.data.tipo == 'PESSOAL'
        && request.resource.data.schemaVersion in [1]
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.data is string
        && request.resource.data.keys().hasOnly([
          'lembreteId', 'tipo', 'schemaVersion', 'titulo', 'descricao',
          'data', 'horario', 'serieId', 'alertasAntecedenciaMin',
          'criadoEm', 'atualizadoEm',
        ]);

      // `tipo`/`schemaVersion` imutáveis: um lembrete pessoal nunca vira
      // outra coisa por update.
      allow update: if autenticado()
        && loginDoAuth() == login
        && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.data is string
        && request.resource.data.keys().hasOnly([
          'lembreteId', 'tipo', 'schemaVersion', 'titulo', 'descricao',
          'data', 'horario', 'serieId', 'alertasAntecedenciaMin',
          'criadoEm', 'atualizadoEm',
        ]);

      // Exclusão definitiva permitida — é conteúdo do próprio colaborador,
      // sem histórico administrativo (diferente de `lembretesAtribuidos`).
      allow delete: if autenticado() && loginDoAuth() == login;
    }

    /**
     * Lembretes atribuídos pelo gestor a um colaborador do seu escopo.
     * Coleção top-level (diferente dos pessoais) porque o gestor
     * legitimamente precisa ler/gerenciar um item que não é dele. A
     * validação do destinatário NUNCA confia isoladamente em
     * `destinatarioEquipeId` do payload — sempre confere contra o
     * `equipeId` real de `usuarios/{destinatarioLogin}` via
     * `usuarioPorLogin()` antes de checar `podeOperarNaEquipe()`.
     */
    match /lembretesAtribuidos/{lembreteId} {
      // Cobre tanto o colaborador lendo o próprio quanto o gestor em escopo
      // lendo/listando os do seu time (Dashboard, Fase 5) — a mesma consulta
      // (`where('destinatarioLogin', '==', X)`) serve os dois casos, cada um
      // autorizado por um ramo diferente do OR.
      allow read: if autenticado()
        && (
          resource.data.destinatarioLogin == loginDoAuth()
          || (souGestor() && podeOperarNaEquipe(resource.data.destinatarioEquipeId))
        );

      allow create: if souGestor()
        && request.resource.data.tipo == 'ATRIBUIDO'
        && request.resource.data.schemaVersion in [1]
        && request.resource.data.status == 'ATIVO'
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.data is string
        && request.resource.data.criadoPorLogin == loginDoAuth()
        && request.resource.data.criadoPorNome == eu().nome
        && request.resource.data.destinatarioEquipeId
          == usuarioPorLogin(request.resource.data.destinatarioLogin).equipeId
        && podeOperarNaEquipe(request.resource.data.destinatarioEquipeId)
        && request.resource.data.get('canceladoEm', null) == null
        && request.resource.data.get('canceladoPorLogin', null) == null
        && request.resource.data.keys().hasOnly([
          'lembreteId', 'tipo', 'schemaVersion', 'destinatarioLogin',
          'destinatarioEquipeId', 'titulo', 'descricao', 'data', 'horario',
          'serieId', 'alertasAntecedenciaMin', 'criadoPorLogin',
          'criadoPorNome', 'status', 'criadoEm', 'atualizadoEm',
          'canceladoEm', 'canceladoPorLogin',
        ]);

      // Destinatário/equipe/autoria/criadoEm imutáveis — só conteúdo e
      // status podem mudar. Status só anda ATIVO -> CANCELADO (nunca volta);
      // qualquer gestor com escopo sobre a equipe pode gerenciar (não só
      // quem criou), mesmo modelo de time usado em `trocasEscala`/
      // `rascunhosTurnosMes`. O destinatário nunca tem `souGestor()`
      // verdadeiro só por ser dono do lembrete, então esta regra já nega
      // update para ele — não precisa de checagem extra.
      allow update: if souGestor()
        && podeOperarNaEquipe(resource.data.destinatarioEquipeId)
        && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.destinatarioLogin == resource.data.destinatarioLogin
        && request.resource.data.destinatarioEquipeId == resource.data.destinatarioEquipeId
        && request.resource.data.criadoPorLogin == resource.data.criadoPorLogin
        && request.resource.data.criadoPorNome == resource.data.criadoPorNome
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.data is string
        && (
          request.resource.data.status == resource.data.status
          || (resource.data.status == 'ATIVO' && request.resource.data.status == 'CANCELADO')
        )
        && (
          request.resource.data.get('canceladoPorLogin', null) == null
          || request.resource.data.canceladoPorLogin == loginDoAuth()
        )
        && request.resource.data.keys().hasOnly([
          'lembreteId', 'tipo', 'schemaVersion', 'destinatarioLogin',
          'destinatarioEquipeId', 'titulo', 'descricao', 'data', 'horario',
          'serieId', 'alertasAntecedenciaMin', 'criadoPorLogin',
          'criadoPorNome', 'status', 'criadoEm', 'atualizadoEm',
          'canceladoEm', 'canceladoPorLogin',
        ]);

      // Sem delete físico para ninguém, nem ADMIN_SISTEMA (revisão da Fase 4):
      // atribuído é registro administrativo, cancelamento (ATIVO -> CANCELADO,
      // acima) já preserva histórico, e a UI nunca precisa apagar. Diferente
      // de `trocasEscala`/`notificacoesTroca` (que permitem delete admin para
      // limpeza seletiva ao excluir um usuário) — aqui, propositalmente, nem
      // essa exceção existe: reter o histórico administrativo importa mais
      // que a limpeza. A pendência de retenção/limpeza ao excluir um usuário
      // continua documentada em docs/spec/LEMBRETES.md, sem dar a
      // gestor/admin acesso aos lembretes pessoais para resolvê-la.
      allow delete: if false;
    }

    match /equipes/{equipeId} {
      allow read: if autenticado();
      // Antes: `if false` (nunca gravável via client, só seed server-side).
      // ADMIN_SISTEMA sempre pode, mesmo sem `unidadeId` (equipe legada,
      // sem unidade organizacional atribuída). GESTOR_UNIDADE só pode
      // criar/editar uma equipe cujo `unidadeId` esteja em
      // `podeOperarNaUnidade()` — o campo já vem no próprio documento
      // (`request.resource.data`/`resource.data`), então não é preciso
      // nenhum `get()` extra nem travessia de `parentId`.
      allow create: if souAdminSistema()
        || (
          request.resource.data.get('unidadeId', null) != null
          && podeOperarNaUnidadeOuDescendente(request.resource.data.unidadeId, request.resource.data.get('caminhoUnidade', null))
        );
      /**
       * Fase ESCOPO-GESTOR-UNIDADE-1 — migração de equipe entre unidades:
       * antes desta fase, só a unidade ATUAL (`resource.data.unidadeId`)
       * era checada, então nada impedia mover a equipe para FORA do escopo
       * do gestor (o novo `unidadeId` do payload nunca era validado). Agora
       * exige que a unidade de origem E a de destino estejam dentro do
       * escopo permitido (ou de uma unidade ancestral, via
       * `caminhoUnidade`) — nunca só uma das duas pontas.
       */
      allow update: if souAdminSistema()
        || (
          resource.data.get('unidadeId', null) != null
          && podeOperarNaUnidadeOuDescendente(resource.data.unidadeId, resource.data.get('caminhoUnidade', null))
          && request.resource.data.get('unidadeId', null) != null
          && podeOperarNaUnidadeOuDescendente(request.resource.data.unidadeId, request.resource.data.get('caminhoUnidade', null))
        );
      // Sem delete no MVP: nada no app hoje apaga equipe; desativar é
      // `ativa: false`. Dezenas de outras coleções referenciam o ID.
      allow delete: if false;
    }

    /**
     * Cadastro administrativo simples antigo — mantido intacto por
     * compatibilidade (não referenciado por `usuarios`/`equipes`/
     * `turnosMes`). A tela "Administração" do dashboard passou a usar
     * `unidadesOrganizacionais` para novos cadastros, mas `setores`
     * continua funcionando exatamente como antes.
     */
    match /setores/{setorId} {
      allow read: if autenticado();
      allow create, update: if souAdminSistema();
      allow delete: if false;
    }

    /**
     * Hierarquia organizacional flexível (qualquer nível acima de
     * `equipes`: diretoria, gerência, coordenação, supervisão...) —
     * coleção ADITIVA, não substitui `setores`/`equipes`.
     *
     * Delete sempre negado: nada apaga uma unidade que possa estar
     * referenciada por `equipes.unidadeId` ou por `unidadeId`/
     * `unidadesPermitidas` de algum usuário.
     *
     * NÃO percorre `parentId`: a checagem de "abaixo de uma unidade
     * permitida" olha só o `parentId` do PRÓPRIO documento sendo criado
     * (um único campo do payload, não uma travessia), contra o array
     * explícito `minhasUnidadesPermitidas()`.
     */
    match /unidadesOrganizacionais/{unidadeId} {
      allow read: if autenticado();

      allow create: if autenticado()
        && request.resource.data.unidadeId == unidadeId
        && request.resource.data.criadoPorLogin == loginDoAuth()
        && (
          souAdminSistema()
          || (request.resource.data.parentId != null && podeOperarNaUnidade(request.resource.data.parentId))
        );

      allow update: if autenticado()
        && request.resource.data.unidadeId == resource.data.unidadeId
        && podeOperarNaUnidade(unidadeId);

      allow delete: if false;
    }

    /**
     * Auditoria do modo simulação de gestor — um doc imutável por ação,
     * mesmo padrão de `historicoPublicacoes`. `atorRealLogin` sempre tem
     * que ser quem está de fato autenticado (nunca o ator simulado).
     *
     * STAGING-RESET-HIERARQUIA-ICI-1 — `create` também aceita
     * `souCoordenadorOperacionalStaging()`: em staging, ações sensíveis
     * feitas diretamente por um coordenador/supervisor (sem um
     * ADMIN_SISTEMA "simulando") também precisam gerar auditoria. `read`
     * continua exclusivo de ADMIN_SISTEMA (o console de auditoria não muda
     * nesta fase); `update`/`delete` continuam sempre negados, mesmo em
     * staging — apagar auditoria nunca é permitido.
     */
    match /auditoriaAdmin/{id} {
      allow read: if souAdminSistema();
      allow create: if (souAdminSistema() || souCoordenadorOperacionalStaging())
        && request.resource.data.atorRealLogin == loginDoAuth();
      allow update, delete: if false;
    }

    /**
     * Matriz de responsáveis por escala (ESCOPO-OPERACIONAL-MATRIZ-1).
     * Leitura autenticada alimenta o resolver operacional; escrita fica
     * restrita a ADMIN_SISTEMA em produção. Consulta (`equipesConsulta`) é
     * somente leitura/monitoramento e nunca concede escrita administrativa.
     * Delete físico negado: desativação é `ativo: false`.
     *
     * STAGING-RESET-HIERARQUIA-ICI-1 — em staging, `souCoordenadorOperacionalStaging()`
     * também pode criar/editar uma entrada, mas SEMPRE restrita ao alvo
     * dentro do PRÓPRIO escopo (equipe/unidade do alvo de JORNADA via
     * `podeOperarNaEquipe()`, ou escopo do Grupo de Plantão via
     * `escopoDoGrupoPlantaoNoMeuAlcance()` para PLANTAO) — nunca abre
     * escrita cross-equipe/unidade fora do que essas funções já garantem
     * em qualquer outra parte do arquivo.
     */
    match /escoposOperacionais/{id} {
      allow read: if autenticado();
      allow create: if id == idEscopoOperacional(request.resource.data.tipo, request.resource.data.alvoId)
        && escopoOperacionalValido(request.resource.data)
        && (
          souAdminSistema()
          || (
            souCoordenadorOperacionalStaging()
            && (
              (request.resource.data.tipo == 'JORNADA' && podeOperarNaEquipe(request.resource.data.alvoId))
              || (
                request.resource.data.tipo == 'PLANTAO'
                && exists(/databases/$(database)/documents/gruposPlantao/$(request.resource.data.alvoId))
                && escopoDoGrupoPlantaoNoMeuAlcance(grupoPlantaoPorId(request.resource.data.alvoId))
              )
            )
          )
        );
      allow update: if escopoOperacionalValido(request.resource.data)
        && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.alvoId == resource.data.alvoId
        && request.resource.data.criadoPorLogin == resource.data.criadoPorLogin
        && (
          souAdminSistema()
          || (
            souCoordenadorOperacionalStaging()
            && (
              (resource.data.tipo == 'JORNADA' && podeOperarNaEquipe(resource.data.alvoId))
              || (
                resource.data.tipo == 'PLANTAO'
                && exists(/databases/$(database)/documents/gruposPlantao/$(resource.data.alvoId))
                && escopoDoGrupoPlantaoNoMeuAlcance(grupoPlantaoPorId(resource.data.alvoId))
              )
            )
          )
        );
      allow delete: if false;
    }

    match /tiposTurno/{docId} {
      allow read: if autenticado();
      allow create: if podeAdministrarJornada(request.resource.data.equipeId);
      allow update: if podeAdministrarJornada(resource.data.equipeId)
        && request.resource.data.equipeId == resource.data.equipeId;
      // O fluxo do produto não exige remoção física do catálogo.
      allow delete: if false;
    }

    match /turnosMes/{docId} {
      allow read: if autenticado()
        && (podeOperarNaEquipe(resource.data.equipeId) || podeAdministrarJornada(resource.data.equipeId))
        && (
          resource.data.status == 'PUBLICADA'
          || souGestor()
        );

      allow create: if podeAdministrarJornada(request.resource.data.equipeId)
        && request.resource.data.schemaVersion in [1]
        && request.resource.data.status == 'PUBLICADA';

      allow update: if podeAdministrarJornada(resource.data.equipeId)
        && request.resource.data.equipeId == resource.data.equipeId
        && request.resource.data.login == resource.data.login
        && request.resource.data.usuarioUid == resource.data.usuarioUid
        && request.resource.data.competencia == resource.data.competencia
        && request.resource.data.schemaVersion in [1]
        && request.resource.data.status == 'PUBLICADA';

      allow delete: if podeAdministrarJornada(resource.data.equipeId);
    }

    match /rascunhosTurnosMes/{docId} {
      allow read: if podeAdministrarJornada(resource.data.equipeId);

      allow create: if podeAdministrarJornada(request.resource.data.equipeId)
        && request.resource.data.schemaVersion in [1]
        && request.resource.data.status == 'RASCUNHO';

      allow update: if podeAdministrarJornada(resource.data.equipeId)
        && request.resource.data.equipeId == resource.data.equipeId
        && request.resource.data.login == resource.data.login
        && request.resource.data.usuarioUid == resource.data.usuarioUid
        && request.resource.data.competencia == resource.data.competencia
        && request.resource.data.schemaVersion in [1]
        && request.resource.data.status == 'RASCUNHO';

      allow delete: if podeAdministrarJornada(resource.data.equipeId);
    }

    match /publicacoesEscala/{id} {
      allow read: if autenticado()
        && (
          resource == null
          || podeAdministrarJornada(resource.data.equipeId)
        );
      allow create: if podeAdministrarJornada(request.resource.data.equipeId)
        && request.resource.data.id == id;
      allow update: if podeAdministrarJornada(resource.data.equipeId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.equipeId == resource.data.equipeId
        && request.resource.data.competencia == resource.data.competencia;
      allow delete: if false;
    }

    match /historicoPublicacoes/{id} {
      allow read: if podeAdministrarJornada(resource.data.equipeId);
      allow create: if podeAdministrarJornada(request.resource.data.equipeId);
      allow update, delete: if false;
    }

    match /versoesEscala/{id} {
      allow read: if podeAdministrarJornada(resource.data.equipeId);
      allow create: if podeAdministrarJornada(request.resource.data.equipeId)
        && request.resource.data.status == 'PUBLICADA';
      allow update, delete: if false;
    }

    match /eventosEscala/{id} {
      allow read: if autenticado()
        && (podeOperarNaEquipe(resource.data.equipeId) || podeAdministrarJornada(resource.data.equipeId))
        && (
          souGestor()
          || resource.data.usuarioUid == loginDoAuth()
        );
      allow create: if podeAdministrarJornada(request.resource.data.equipeId)
        && request.resource.data.publicadoPor == loginDoAuth()
        && request.resource.data.alteracoes is list;
      allow update, delete: if false;
    }

    match /importacoes/{id} {
      // `read` sem filtro de equipe é pré-existente (nenhum código do app
      // hoje lê/lista `importacoes` — só escreve, em writeRepository.ts) e
      // fica assim de propósito: introduzir `resource.data.equipeId` num
      // `read` que cobre `list` reabriria o mesmo risco de erro de
      // avaliação que exigiu o hotfix de get/list separado em
      // `trocasEscala` (ver comentário abaixo), por um ganho prático nulo
      // hoje. `souGestor()` já cobre ADMIN_SISTEMA.
      allow read: if souGestor();
      allow create: if autenticado()
        && request.resource.data.enviadoPor == loginDoAuth()
        && podeAdministrarJornada(request.resource.data.equipeId);
      allow update, delete: if false;
    }

    /**
     * Troca de escala (docs/spec/TROCA_ESCALA_PLANO.md) — primeira coleção
     * que o App do colaborador escreve, além de ler. Escopo de escrita
     * deliberadamente estreito: o App só cria a solicitação e move
     * PENDENTE_USUARIO -> {RECUSADA_USUARIO, PENDENTE_GESTOR,
     * CANCELADA_SOLICITANTE}; qualquer transição a partir de
     * PENDENTE_GESTOR é exclusividade do gestor. `historico` só pode
     * crescer (nunca é reescrito por trás).
     *
     * Hotfix 2 (permission-denied intermitente): `allow read` unificado com
     * a condição OR (souGestor() || solicitanteLogin==... ||
     * destinatarioLogin==...) falha de verdade no emulador — confirmado com
     * um teste isolado — quando um `list` (consulta com `where()`, exatamente
     * o que `observarTrocasDoGestor`/`observarTrocasDoUsuario` fazem) não
     * tem nenhum documento correspondente ao filtro do usuário atual mas EXISTE
     * algum documento de OUTRA equipe na coleção: o motor de regras avalia a
     * condição contra esse documento não relacionado e nega a consulta
     * inteira (`evaluation error ... false for 'list'`), não só o
     * documento — em vez de simplesmente devolver uma lista vazia. Separar
     * `get` (documento único, mantém a condição OR completa) de `list`
     * (consulta, condição simples só por equipe) resolve isso. Único efeito
     * colateral aceito: um colega comum passa a poder listar TODAS as
     * trocas da própria equipe (não só as suas) se montar a query sem o
     * filtro de papel — mesmo nível de exposição que `turnosMes` já tem
     * hoje (qualquer membro da equipe já lê a escala publicada de todo
     * colega, não só a própria).
     */
    match /trocasEscala/{id} {
      // ESCOPO-OPERACIONAL-MATRIZ-2 — o responsável operacional da Jornada
      // (Matriz) precisa poder LER a troca antes de poder aprová-la/
      // recusá-la, mesmo quando ele não pertence à equipe (podeOperarNaEquipe)
      // e não é "gestor" no sentido legado (souGestor()). `podeAdministrarJornada()`
      // já cobre ADMIN_SISTEMA + matriz ativa + fallback legado quando a
      // matriz não existe para o alvo — mesmo caminho usado no `update` de
      // aprovação abaixo.
      allow get: if autenticado()
        && (
          (
            podeOperarNaEquipe(resource.data.equipeId)
            && (
              souGestor()
              || resource.data.solicitanteLogin == loginDoAuth()
              || resource.data.destinatarioLogin == loginDoAuth()
            )
          )
          || podeAdministrarJornada(resource.data.equipeId)
        );

      allow list: if autenticado()
        && (podeOperarNaEquipe(resource.data.equipeId) || podeAdministrarJornada(resource.data.equipeId));

      // Autoatendimento — quem cria age como membro da própria equipe, não
      // como admin cross-equipe. Deliberadamente não usa
      // podeOperarNaEquipe().
      allow create: if autenticado()
        && request.resource.data.equipeId == minhaEquipe()
        && request.resource.data.solicitanteLogin == loginDoAuth()
        && request.resource.data.destinatarioLogin != loginDoAuth()
        && request.resource.data.status == 'PENDENTE_USUARIO';

      allow update: if autenticado()
        && request.resource.data.historico.size() > resource.data.historico.size()
        && (
          (
            podeOperarNaEquipe(resource.data.equipeId)
            && resource.data.destinatarioLogin == loginDoAuth()
            && resource.data.status == 'PENDENTE_USUARIO'
            && request.resource.data.status in ['RECUSADA_USUARIO', 'PENDENTE_GESTOR']
          )
          || (
            podeOperarNaEquipe(resource.data.equipeId)
            && resource.data.solicitanteLogin == loginDoAuth()
            && resource.data.status == 'PENDENTE_USUARIO'
            && request.resource.data.status == 'CANCELADA_SOLICITANTE'
          )
          // ESCOPO-OPERACIONAL-MATRIZ-2 — a parte gerencial (aprovar/recusar
          // como gestor) não é mais "souGestor() + podeOperarNaEquipe()"
          // pura: passa a ser autorização operacional da Jornada.
          // `podeAdministrarJornada()` já cobre, nesta ordem: ADMIN_SISTEMA;
          // responsável operacional ativo na Matriz para tipo=JORNADA e
          // alvoId=equipeId da troca; fallback para souGestor() +
          // podeOperarNaEquipe() só quando não existe matriz para essa
          // Jornada. Nunca aceita responsável de PLANTAO administrar troca
          // de Jornada — `podeAdministrarJornada` só olha a matriz tipo
          // JORNADA.
          || (
            podeAdministrarJornada(resource.data.equipeId)
            && resource.data.status == 'PENDENTE_GESTOR'
            && request.resource.data.status in ['RECUSADA_GESTOR', 'APROVADA_PUBLICADA']
          )
        );

      // Era `if false` — ADMIN_SISTEMA precisa poder apagar trocas
      // vinculadas a um usuário excluído (limpeza seletiva, ver
      // lib/firebase/adminRepository.ts).
      allow delete: if souAdminSistema();
    }

    /**
     * Notificações de troca — coleção nova e dedicada (não reaproveita
     * `eventosEscala`, que é só para publicação em massa). Quem cria é
     * sempre quem executou a ação (solicitante, destinatário ou gestor),
     * nunca o próprio destinatário da notificação; `criadoPorLogin`
     * autentica o autor sem depender de `get()` sobre `trocasEscala` (a
     * troca e a notificação são criadas no mesmo lote, e `get()`/`exists()`
     * em regras não veem escritas pendentes do mesmo lote).
     */
    match /notificacoesTroca/{id} {
      // Admin precisa enumerar (list/get) notificações de qualquer usuário
      // para poder excluir as vinculadas a uma conta removida — sem alargar
      // a exposição para o resto da equipe (diferente de `trocasEscala`
      // acima): só o próprio destinatário ou um admin de verdade.
      //
      // A checagem de admin só passa em `list` se a CONSULTA também filtrar
      // por `equipeId` — confirmado com teste isolado no emulador: uma
      // condição de `list` cujo campo não corresponde a nenhum `where()` da
      // consulta (ex.: checar `equipeId` numa query só com
      // `destinatarioLogin`) falha com "evaluation error" nesta coleção.
      // Por isso `excluirUsuario()` (lib/firebase/adminRepository.ts)
      // sempre inclui `where('equipeId', '==', ...)` além do filtro por
      // login.
      allow read: if autenticado()
        && (
          resource.data.destinatarioLogin == loginDoAuth()
          || (resource.data.get('equipeId', null) != null && souAdminSistema())
        );

      // ESCOPO-OPERACIONAL-MATRIZ-2 — a notificação de uma ação GERENCIAL
      // (aprovar/recusar/publicar troca) é criada no mesmo batch da
      // atualização de `trocasEscala`, pelo responsável operacional da
      // Jornada — que pode não pertencer à equipe (`minhaEquipe()` falha
      // para ele). Segundo ramo (OR) cobre exatamente esse caso, sem abrir
      // criação de notificação de QUALQUER equipe: exige matriz ativa de
      // JORNADA para o `equipeId` da notificação e `tipo` restrito às duas
      // notificações que uma ação gerencial de fato gera. Nunca permite
      // forjar `criadoPorLogin` (mesma checagem do ramo de autoatendimento).
      allow create: if autenticado()
        && request.resource.data.criadoPorLogin == loginDoAuth()
        && request.resource.data.destinatarioLogin != loginDoAuth()
        && request.resource.data.lidaEm == null
        && (
          request.resource.data.equipeId == minhaEquipe()
          || (
            podeAdministrarJornada(request.resource.data.equipeId)
            && request.resource.data.tipo in ['TROCA_RECUSADA_GESTOR', 'TROCA_APROVADA_PUBLICADA']
          )
        );

      allow update: if autenticado()
        && resource.data.destinatarioLogin == loginDoAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lidaEm']);

      // Era `if false` — ADMIN_SISTEMA precisa poder apagar notificações
      // vinculadas a um usuário excluído.
      allow delete: if souAdminSistema();
    }

    /**
     * Dispositivos com Firebase Installation ID (FID) para push (Fase
     * Push-1B, ver apps/push-worker e CHECKPOINT-FASE-PUSH-1B-FID.md — a
     * Fase Push-1A original usava `token`, migrado sem compatibilidade
     * ativa). A chave é `deviceId`, não `login` — um usuário pode ter mais
     * de um aparelho (WEB e/ou ANDROID). O worker (Admin SDK) ignora estas
     * regras via IAM; elas só protegem o caminho do client SDK (PWA/app),
     * garantindo que cada usuário só veja/gerencie o próprio dispositivo,
     * com o `fid` sempre presente e nunca um campo `token` legado.
     */
    match /dispositivosPush/{deviceId} {
      // `resource == null` cobre a primeira ativação: `registrarOuRenovarDispositivo()`
      // sempre faz um `getDoc()` antes do `setDoc()` para decidir criar vs.
      // renovar, e nessa primeira chamada o documento ainda não existe —
      // sem esse curto-circuito, `resource.data.login` avalia contra um
      // `resource` nulo e o Firestore nega o `get` com erro de avaliação
      // antes mesmo do cliente chegar ao `create`. Documento existente
      // continua exigindo o mesmo login do dono.
      allow get: if autenticado() && (resource == null || resource.data.login == loginDoAuth());

      // Sem `list`: o client só precisa checar/atualizar o próprio
      // dispositivo, cujo id ele já conhece — nunca enumerar dispositivos
      // de outra pessoa. O FID nunca fica listável por terceiros.
      allow list: if false;

      allow create: if autenticado()
        && request.resource.data.login == loginDoAuth()
        && request.resource.data.deviceId == deviceId
        && request.resource.data.fid is string
        && request.resource.data.fid.size() > 0
        && request.resource.data.plataforma in ['WEB', 'ANDROID']
        && request.resource.data.ativo is bool
        && request.resource.data.environment == 'STAGING'
        && request.resource.data.schemaVersion in [1]
        && !('token' in request.resource.data)
        && request.resource.data.keys().hasOnly([
          'deviceId', 'login', 'plataforma', 'fid', 'ativo',
          'criadoEm', 'atualizadoEm', 'ultimaConfirmacaoEm', 'appVersion',
          'environment', 'schemaVersion',
        ]);

      // `login`/`deviceId`/`environment` imutáveis; `fid` pode ser
      // renovado (é exatamente o caso de uso — o FID muda com o tempo);
      // `ativo`/timestamps/`plataforma`/`appVersion`/`schemaVersion` podem
      // ser atualizados. Nunca aceita reintroduzir `token`.
      allow update: if autenticado()
        && resource.data.login == loginDoAuth()
        && request.resource.data.login == resource.data.login
        && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.environment == resource.data.environment
        && request.resource.data.fid is string
        && request.resource.data.fid.size() > 0
        && request.resource.data.plataforma in ['WEB', 'ANDROID']
        && request.resource.data.ativo is bool
        && !('token' in request.resource.data)
        && request.resource.data.keys().hasOnly([
          'deviceId', 'login', 'plataforma', 'fid', 'ativo',
          'criadoEm', 'atualizadoEm', 'ultimaConfirmacaoEm', 'appVersion',
          'environment', 'schemaVersion',
        ]);

      allow delete: if autenticado() && resource.data.login == loginDoAuth();
    }

    /**
     * Controle técnico de idempotência/entrega do push-worker (Fase
     * Push-1). Zero acesso via client SDK, propositalmente — só o Admin
     * SDK, autenticado por IAM, lê/escreve aqui. Nunca "abrir" esta coleção
     * para facilitar o worker: Admin SDK não depende de Security Rules.
     */
    match /pushEntregas/{notificacaoId} {
      allow read, write: if false;
    }

    /**
     * Grupo de Plantão (Fase PLANTÃO-3A). `equipeResponsavelId` imutável
     * após criado (reatribuir o grupo a outra equipe é decisão adiada —
     * evita esvaziar acidentalmente o poder de gestão de quem administrava
     * antes). `equipesConsulta` sempre precisa conter a própria
     * `equipeResponsavelId` — nunca fica vazio nem depende de fallback em
     * tempo de leitura (ver `equipesConsultaEfetivas()` em
     * `@escala-ici/contrato`). Sem `delete` — igual `equipes`/
     * `unidadesOrganizacionais`, desativar é `ativo: false`.
     */
    match /gruposPlantao/{grupoId} {
      /**
       * Fase ESCOPO-GESTOR-UNIDADE-1 — `podeGerenciarGrupoPlantao(resource.data)`
       * entra como um terceiro caminho de leitura (OR, nunca substituindo
       * `equipesConsulta`): quem ADMINISTRA um Grupo (`GESTOR_EQUIPE`/
       * `ADMIN_SISTEMA` da equipe responsável, ou `GESTOR_UNIDADE` da
       * unidade responsável/ancestral) sempre consegue LER esse Grupo,
       * mesmo que a própria equipe do gestor não esteja em
       * `equipesConsulta` — administração nunca deveria depender de uma
       * ACL de consulta (`equipesConsulta` é visibilidade OPERACIONAL, não
       * administrativa — ver `docs/spec/ESCOPO_OPERACIONAL_GESTOR_UNIDADE.md`).
       *
       * Fase ESCOPO-CONSULTA-PLANTAO-1 — `GESTOR_EQUIPE`/`SUPERVISOR_EQUIPE`
       * também leem qualquer Grupo (mesmo fora de `equipesConsulta` e sem
       * administrá-lo), para poder DESCOBRIR quais Grupos existem antes de
       * decidir vincular a própria equipe (autovínculo de consulta, seção
       * "Plantões monitorados por equipe"). Só metadado do Grupo é exposto
       * aqui (nome, descrição, equipe/unidade responsável, timezone,
       * `equipesConsulta`, padrão semanal) — contatos de plantonista
       * continuam protegidos pela regra própria da subcoleção
       * `participantes` (`podeConsultarGrupoPlantao()`), inalterada.
       */
      allow read: if autenticado()
        && (
          souAdminSistema()
          || minhaEquipe() in resource.data.equipesConsulta
          || podeGerenciarGrupoPlantao(resource.data)
          || matrizConcedeAdministracao('PLANTAO', grupoId)
          || matrizConcedeConsultaPlantao(grupoId)
          || meuPerfil() in ['GESTOR_EQUIPE', 'SUPERVISOR_EQUIPE']
        );

      /**
       * Fase ESCOPO-GESTOR-UNIDADE-1 — criação passa a aceitar dois
       * caminhos de autorização (OR): o de sempre (`souGestor() &&
       * podeOperarNaEquipe(...)`, GESTOR_EQUIPE/ADMIN_SISTEMA sobre a
       * equipe responsável) OU `GESTOR_UNIDADE` cuja unidade permitida
       * contenha `unidadeResponsavelId` do payload (ou uma unidade
       * ancestral dela, via `caminhoUnidadeResponsavel`). `souAdminSistema()`
       * já está coberto pelo primeiro ramo (`souGestor()` inclui admin).
       */
      allow create: if autenticado()
        && request.resource.data.grupoId == grupoId
        && request.resource.data.equipeResponsavelId in request.resource.data.equipesConsulta
        && (
          (souGestor() && podeOperarNaEquipe(request.resource.data.equipeResponsavelId))
          || (
            souGestorUnidade()
            && request.resource.data.get('unidadeResponsavelId', null) != null
            && (
              request.resource.data.unidadeResponsavelId in minhasUnidadesPermitidas()
              || (
                request.resource.data.get('caminhoUnidadeResponsavel', []) is list
                && request.resource.data.get('caminhoUnidadeResponsavel', []).hasAny(minhasUnidadesPermitidas())
              )
            )
          )
        )
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0
        && request.resource.data.ativo is bool
        && (request.resource.data.get('unidadeResponsavelId', null) == null || request.resource.data.unidadeResponsavelId is string)
        && (request.resource.data.get('caminhoUnidadeResponsavel', null) == null || request.resource.data.caminhoUnidadeResponsavel is list)
        && request.resource.data.timezone is string && request.resource.data.timezone.size() > 0
        && request.resource.data.equipesConsulta is list && request.resource.data.equipesConsulta.size() > 0
        && request.resource.data.schemaVersion in [1]
        && request.resource.data.criadoPorLogin == loginDoAuth()
        && padraoHorarioSemanalDoRequestValido(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'grupoId', 'nome', 'descricao', 'equipeResponsavelId', 'equipesConsulta',
          'unidadeResponsavelId', 'caminhoUnidadeResponsavel',
          'timezone', 'ativo', 'padraoHorarioSemanal', 'schemaVersion', 'criadoPorLogin', 'criadoEm', 'atualizadoEm',
        ]);

      /**
       * Fase PROVISIONAMENTO-GRUPO-PLANTAO-1 — `podeGerenciarGrupoPlantao()`
       * é checada tanto sobre `resource.data` (estado atual) quanto sobre
       * `request.resource.data` (estado novo): a primeira checagem sozinha
       * deixava `unidadeResponsavelId` migrar livremente para FORA do
       * escopo do gestor (mesma classe de gap corrigida para `equipes` na
       * Fase ESCOPO-GESTOR-UNIDADE-1 — origem OK não bastava, faltava
       * checar o destino). Não afeta o caminho `GESTOR_EQUIPE`
       * (`equipeResponsavelId` já é imutável, então a checagem em cima do
       * estado novo é equivalente à de cima do estado atual nesse caso).
       */
      allow update: if autenticado()
        && (
          (
            podeGerenciarGrupoPlantao(resource.data)
            && podeGerenciarGrupoPlantao(request.resource.data)
            && request.resource.data.grupoId == resource.data.grupoId
            && request.resource.data.equipeResponsavelId == resource.data.equipeResponsavelId
            && request.resource.data.criadoPorLogin == resource.data.criadoPorLogin
            && request.resource.data.criadoEm == resource.data.criadoEm
            && request.resource.data.equipeResponsavelId in request.resource.data.equipesConsulta
            && request.resource.data.nome is string && request.resource.data.nome.size() > 0
            && request.resource.data.ativo is bool
            && (request.resource.data.get('unidadeResponsavelId', null) == null || request.resource.data.unidadeResponsavelId is string)
            && (request.resource.data.get('caminhoUnidadeResponsavel', null) == null || request.resource.data.caminhoUnidadeResponsavel is list)
            && request.resource.data.timezone is string && request.resource.data.timezone.size() > 0
            && request.resource.data.equipesConsulta is list && request.resource.data.equipesConsulta.size() > 0
            && request.resource.data.schemaVersion in [1]
            && padraoHorarioSemanalDoRequestValido(request.resource.data)
            && request.resource.data.keys().hasOnly([
              'grupoId', 'nome', 'descricao', 'equipeResponsavelId', 'equipesConsulta',
              'unidadeResponsavelId', 'caminhoUnidadeResponsavel',
              'timezone', 'ativo', 'padraoHorarioSemanal', 'schemaVersion', 'criadoPorLogin', 'criadoEm', 'atualizadoEm',
            ])
          )
          || (
            /**
             * Fase ESCOPO-CONSULTA-PLANTAO-1 — autovínculo de consulta:
             * caminho totalmente separado do bloco acima, NUNCA exige
             * `podeGerenciarGrupoPlantao()` (a supervisora do NOC não
             * administra o Plantão de outra coordenação). Restrito a
             * alterar somente `equipesConsulta` (+ `atualizadoEm`) —
             * `diff().affectedKeys().hasOnly(...)` garante que nenhum
             * outro campo (nome, descrição, equipe/unidade responsável,
             * timezone, ativo, padrão semanal, participantes/competências
             * — que nem fazem parte deste documento) muda nesta operação.
             */
            podeAutoVincularConsultaPlantao(resource.data.equipesConsulta, request.resource.data.equipesConsulta, resource.data.equipeResponsavelId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['equipesConsulta', 'atualizadoEm'])
            && request.resource.data.equipesConsulta is list
          )
        );

      allow delete: if false;
    }

    /**
     * Participante do Grupo de Plantão — subcoleção, ID = login
     * (determinístico). Consultar exige só `podeConsultarGrupoPlantao()`
     * (SOC/NOC podem ver quem está no Plantão de Segurança sem participar
     * dele); administrar (criar/editar, inclusive contatos) exige
     * `podeGerenciarGrupoPlantao()` — participar do grupo NUNCA dá poder
     * administrativo sobre ele. `login` precisa corresponder a um usuário
     * cadastrado (`exists()`) — nunca inventa identidade.
     */
    match /gruposPlantao/{grupoId}/participantes/{login} {
      allow read: if podeLerEscalaPlantao(grupoId);

      allow create: if autenticado()
        && podeAdministrarEscalaPlantao(grupoId)
        && exists(/databases/$(database)/documents/usuarios/$(login))
        && request.resource.data.grupoId == grupoId
        && request.resource.data.login == login
        && request.resource.data.ativo is bool
        && contatosPlantonistaValidos(request.resource.data.contatos)
        && request.resource.data.schemaVersion in [1]
        && request.resource.data.criadoPorLogin == loginDoAuth()
        && request.resource.data.keys().hasOnly([
          'grupoId', 'login', 'ativo', 'ordem', 'contatos',
          'schemaVersion', 'criadoPorLogin', 'criadoEm', 'atualizadoEm',
        ]);

      allow update: if autenticado()
        && (
          (
            podeAdministrarEscalaPlantao(grupoId)
            && request.resource.data.grupoId == resource.data.grupoId
            && request.resource.data.login == resource.data.login
            && request.resource.data.criadoPorLogin == resource.data.criadoPorLogin
            && request.resource.data.criadoEm == resource.data.criadoEm
            && request.resource.data.ativo is bool
            && contatosPlantonistaValidos(request.resource.data.contatos)
            && corPlantonistaPreferidaValida(request.resource.data.get('corPreferida', null))
            && request.resource.data.schemaVersion in [1]
            && request.resource.data.keys().hasOnly([
              'grupoId', 'login', 'ativo', 'ordem', 'contatos', 'corPreferida',
              'schemaVersion', 'criadoPorLogin', 'criadoEm', 'atualizadoEm',
            ])
          )
          // FASE-PLANTAO-POS-PUBLICACAO-APP-VISUALIZACAO-1/2 — o próprio
          // plantonista atualiza os PRÓPRIOS contatos e a própria cor de
          // identificação no calendário, a partir do App
          // (`atualizarContatosPlantonista()`/`atualizarCorPlantonista()`,
          // lib/firebase/plantaoWriteRepository.ts). Mesmo padrão de
          // `usuarios/{login}` self-update (`hasOnly(['nome'])` acima):
          // allowlist fechada por `diff().affectedKeys()`, nunca
          // `perfil`/`escopo`/`ativo`/`ordem`/`grupoId`/`login` — participação
          // de Plantão nunca altera cadastro nem autorização.
          || (
            loginDoAuth() == login
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contatos', 'corPreferida', 'atualizadoEm'])
            && contatosPlantonistaValidos(request.resource.data.contatos)
            && corPlantonistaPreferidaValida(request.resource.data.get('corPreferida', null))
          )
        );

      allow delete: if false;
    }

    /**
     * Competência de Plantão — RASCUNHO e PUBLICADA são coleções
     * SEPARADAS (mesmo padrão de `rascunhosTurnosMes`/`turnosMes`): nunca
     * um único campo `status` filtrando a mesma coleção, para uma consulta
     * de colaborador jamais poder "vazar" um rascunho por engano.
     * `rascunhosCompetenciasPlantao` só existe enquanto RASCUNHO — gestor
     * autorizado (`podeGerenciarGrupoPlantao`) lê/escreve; nunca visível a
     * quem só pode consultar.
     *
     * Fase ESCALAS-UX-1C — `origem` passou a aceitar também `'COPIADO'`
     * ("Usar período anterior", uma nova competência cujas atribuições
     * nascem de cópia estrutural de uma competência anterior). Mudança
     * mecânica: só o valor aceito na lista muda, nenhuma condição de
     * autorização nova.
     */
    match /rascunhosCompetenciasPlantao/{id} {
      allow read: if podeLerEscalaPlantao(resource.data.grupoId);

      allow create: if autenticado()
        && podeAdministrarEscalaPlantao(request.resource.data.grupoId)
        && request.resource.data.id == id
        && request.resource.data.status == 'RASCUNHO'
        && request.resource.data.revisao == 0
        && request.resource.data.competencia is string && request.resource.data.competencia.size() > 0
        && request.resource.data.periodoInicio is string
        && request.resource.data.periodoFim is string
        && request.resource.data.origem in ['IMPORTADO', 'MANUAL', 'GERADO', 'COPIADO']
        && request.resource.data.schemaVersion in [1]
        && request.resource.data.criadoPorLogin == loginDoAuth()
        && request.resource.data.totalBruto.keys().hasOnly(['quantidade', 'minutos'])
        && (
          request.resource.data.totaisInformadosOrigem == null
          || request.resource.data.totaisInformadosOrigem.keys()
            .hasOnly(['totalPlantoesInformado', 'totalMinutosInformado'])
        )
        && request.resource.data.keys().hasOnly([
          'id', 'grupoId', 'competencia', 'periodoInicio', 'periodoFim', 'status',
          'revisao', 'origem', 'totaisInformadosOrigem', 'totalBruto', 'schemaVersion',
          'criadoPorLogin', 'criadoEm', 'atualizadoEm',
        ]);

      allow update: if autenticado()
        && podeAdministrarEscalaPlantao(resource.data.grupoId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.grupoId == resource.data.grupoId
        && request.resource.data.criadoPorLogin == resource.data.criadoPorLogin
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.status == 'RASCUNHO'
        && request.resource.data.revisao == 0
        && request.resource.data.origem in ['IMPORTADO', 'MANUAL', 'GERADO', 'COPIADO']
        && request.resource.data.schemaVersion in [1]
        && request.resource.data.totalBruto.keys().hasOnly(['quantidade', 'minutos'])
        && (
          request.resource.data.totaisInformadosOrigem == null
          || request.resource.data.totaisInformadosOrigem.keys()
            .hasOnly(['totalPlantoesInformado', 'totalMinutosInformado'])
        )
        && request.resource.data.keys().hasOnly([
          'id', 'grupoId', 'competencia', 'periodoInicio', 'periodoFim', 'status',
          'revisao', 'origem', 'totaisInformadosOrigem', 'totalBruto', 'schemaVersion',
          'criadoPorLogin', 'criadoEm', 'atualizadoEm',
        ]);

      allow delete: if autenticado() && podeAdministrarEscalaPlantao(resource.data.grupoId);
    }

    /**
     * Atribuições do rascunho — subcoleção, cada intervalo é o próprio
     * documento (não um mapa gigante), para uma futura substituição pontual
     * (override, PLANTÃO-6) poder mirar uma atribuição específica sem
     * reescrever a competência inteira. `duracaoMinutos` é validado contra
     * `inicio`/`fim` no cliente (`validarAtribuicaoPlantaoPersistida`) —
     * aqui só o formato/autorização são checados (Rules não fazem
     * aritmética de datas ISO).
     */
    match /rascunhosCompetenciasPlantao/{id}/atribuicoes/{atribuicaoId} {
      allow read: if podeLerEscalaPlantao(resource.data.grupoId);

      allow create: if autenticado()
        && podeAdministrarEscalaPlantao(request.resource.data.grupoId)
        && request.resource.data.atribuicaoId == atribuicaoId
        && request.resource.data.competenciaId == id
        && request.resource.data.plantonistaLogin is string && request.resource.data.plantonistaLogin.size() > 0
        && request.resource.data.inicio is string
        && request.resource.data.fim is string
        && request.resource.data.duracaoMinutos is int && request.resource.data.duracaoMinutos > 0
        && request.resource.data.papel in ['PRIMARIO', 'SECUNDARIO']
        && request.resource.data.origem in ['IMPORTADO', 'MANUAL', 'GERADO', 'COPIADO']
        && request.resource.data.revisao == 0
        && request.resource.data.schemaVersion in [1]
        && request.resource.data.keys().hasOnly([
          'atribuicaoId', 'grupoId', 'competenciaId', 'plantonistaLogin', 'inicio', 'fim',
          'duracaoMinutos', 'papel', 'origem', 'revisao', 'schemaVersion', 'criadoEm', 'atualizadoEm',
        ]);

      allow update: if autenticado()
        && podeAdministrarEscalaPlantao(resource.data.grupoId)
        && request.resource.data.atribuicaoId == resource.data.atribuicaoId
        && request.resource.data.grupoId == resource.data.grupoId
        && request.resource.data.competenciaId == resource.data.competenciaId
        && request.resource.data.plantonistaLogin is string && request.resource.data.plantonistaLogin.size() > 0
        && request.resource.data.inicio is string
        && request.resource.data.fim is string
        && request.resource.data.duracaoMinutos is int && request.resource.data.duracaoMinutos > 0
        && request.resource.data.papel in ['PRIMARIO', 'SECUNDARIO']
        && request.resource.data.origem in ['IMPORTADO', 'MANUAL', 'GERADO', 'COPIADO']
        && request.resource.data.schemaVersion in [1]
        && request.resource.data.keys().hasOnly([
          'atribuicaoId', 'grupoId', 'competenciaId', 'plantonistaLogin', 'inicio', 'fim',
          'duracaoMinutos', 'papel', 'origem', 'revisao', 'schemaVersion', 'criadoEm', 'atualizadoEm',
        ]);

      allow delete: if autenticado() && podeAdministrarEscalaPlantao(resource.data.grupoId);
    }

    /**
     * Competência PUBLICADA — ESCOPO-OPERACIONAL-MATRIZ-2 habilita
     * create/update somente para o administrador do alvo real (`grupoId`).
     * Delete físico continua bloqueado.
     *
     * PATCH-PLANTAO-PUBLICACAO-UX-VIEWS-1 — causa raiz de "As regras de
     * escrita ainda não reconhecem a matriz operacional neste ambiente" ao
     * publicar: `publicarCompetenciaPlantao()` sempre faz um `getDoc()`
     * neste documento ANTES de escrever (para saber se já existe uma
     * revisão anterior). Na primeira publicação de uma competência, o
     * documento ainda não existe — `resource` é `null` e
     * `resource.data.grupoId` não pode ser resolvido, o que fazia a cadeia
     * de `podeLerEscalaPlantao()`/`podeAdministrarEscalaPlantao()` estourar
     * o limite de expressões da regra (erro de avaliação, reportado ao
     * client como `permission-denied` — indistinguível de uma autorização
     * negada de verdade). `!exists(...)` de curto-circuito resolve: ler um
     * documento que NÃO existe nunca expõe dado nenhum (é exatamente o que
     * `getDoc()` já devolve como `{ exists: false }`), então liberar essa
     * leitura para qualquer autenticado é seguro — a autorização de
     * verdade continua intacta assim que o documento existe.
     */
    match /competenciasPlantao/{id} {
      allow read: if autenticado()
        && (
          !exists(/databases/$(database)/documents/competenciasPlantao/$(id))
          || podeLerEscalaPlantao(resource.data.grupoId)
        );
      allow create, update: if podeAdministrarEscalaPlantao(request.resource.data.grupoId)
        && request.resource.data.id == id
        && request.resource.data.status == 'PUBLICADA'
        && request.resource.data.revisao > 0
        && request.resource.data.competencia is string && request.resource.data.competencia.size() > 0
        && request.resource.data.periodoInicio is string
        && request.resource.data.periodoFim is string
        && request.resource.data.origem in ['IMPORTADO', 'MANUAL', 'GERADO', 'COPIADO']
        && request.resource.data.schemaVersion in [1]
        && request.resource.data.totalBruto.keys().hasOnly(['quantidade', 'minutos'])
        && request.resource.data.keys().hasOnly([
          'id', 'grupoId', 'competencia', 'periodoInicio', 'periodoFim', 'status',
          'revisao', 'origem', 'totaisInformadosOrigem', 'totalBruto', 'schemaVersion',
          'criadoPorLogin', 'criadoEm', 'atualizadoEm',
        ])
        && (
          !exists(/databases/$(database)/documents/competenciasPlantao/$(id))
          || (
            request.resource.data.grupoId == resource.data.grupoId
            && request.resource.data.competencia == resource.data.competencia
            && request.resource.data.criadoPorLogin == resource.data.criadoPorLogin
            && request.resource.data.criadoEm == resource.data.criadoEm
            && request.resource.data.revisao > resource.data.revisao
          )
        );
      allow delete: if false;
    }

    match /competenciasPlantao/{id}/atribuicoes/{atribuicaoId} {
      allow read: if podeLerEscalaPlantao(resource.data.grupoId);
      allow create, update: if podeAdministrarEscalaPlantao(request.resource.data.grupoId)
        && request.resource.data.atribuicaoId == atribuicaoId
        && request.resource.data.competenciaId == id
        && request.resource.data.plantonistaLogin is string && request.resource.data.plantonistaLogin.size() > 0
        && request.resource.data.inicio is string
        && request.resource.data.fim is string
        && request.resource.data.duracaoMinutos is int && request.resource.data.duracaoMinutos > 0
        && request.resource.data.papel in ['PRIMARIO', 'SECUNDARIO']
        && request.resource.data.origem in ['IMPORTADO', 'MANUAL', 'GERADO', 'COPIADO']
        && request.resource.data.revisao > 0
        && request.resource.data.schemaVersion in [1]
        && request.resource.data.keys().hasOnly([
          'atribuicaoId', 'grupoId', 'competenciaId', 'plantonistaLogin', 'inicio', 'fim',
          'duracaoMinutos', 'papel', 'origem', 'revisao', 'schemaVersion', 'criadoEm', 'atualizadoEm',
        ])
        && (
          !exists(/databases/$(database)/documents/competenciasPlantao/$(id)/atribuicoes/$(atribuicaoId))
          || (
            request.resource.data.grupoId == resource.data.grupoId
            && request.resource.data.competenciaId == resource.data.competenciaId
            && request.resource.data.revisao > resource.data.revisao
          )
        );
      allow delete: if false;
    }

    /**
     * FASE-TROCAS-PLANTAO-1 — trocas de PLANTÃO. Coleção PRÓPRIA, nunca
     * `trocasEscala`: aquela é modelada por DIA + código de turno de
     * catálogo da Jornada 6x1 (`turnoSolicitanteAntes`,
     * `aplicarTrocaNosDias`); esta é modelada por ATRIBUIÇÃO/intervalo —
     * "dois domínios, não um" (docs/spec/PLANTOES.md). Estrutura espelha
     * `trocasEscala` (get/list separados, `historico` só cresce, uma branch
     * de `update` por ator), trocando `equipeId` -> `grupoId` e
     * `podeAdministrarJornada()` -> `podeAdministrarEscalaPlantao()`. Mudar
     * a tabela de transições aqui sem mudar `TRANSICOES_TROCA_PLANTAO`
     * (lib/trocasPlantao.ts) — ou vice-versa — quebra a fronteira: não
     * existe Cloud Function neste projeto, toda transição de status é
     * escrita de client autorizada só por Rules.
     *
     * NESTA FASE A APROVAÇÃO NÃO ESCREVE EM `competenciasPlantao`: o modelo
     * BASE/OVERRIDE/EFETIVA que permitiria uma troca cirúrgica está
     * reservado mas não implementado (docs/spec/PLANTOES.md, PLANTÃO-6), e
     * as Rules de atribuição publicada (acima) só aceitam republicação da
     * competência inteira com `revisao` estritamente crescente. `APROVADA`
     * é status TERMINAL DE DECISÃO, não de efetivação — o ajuste real na
     * escala publicada continua sendo edição manual do coordenador no
     * Dashboard.
     *
     * `get`/`list` separados pelo mesmo motivo já documentado em
     * `trocasEscala` (quirk do emulador: uma condição de `list` avaliada
     * contra um documento não relacionado nega a consulta inteira). `list`
     * é deliberadamente MAIS ESTREITO que o de `trocasEscala` (que libera a
     * equipe inteira): quem só CONSULTA o Grupo (`equipesConsulta`) não
     * enumera pedidos de troca de terceiros — só participante ativo ou quem
     * administra o Grupo.
     *
     * "Estar no futuro" não é verificável em Rules (não há comparação entre
     * `request.time` e uma string ISO arbitrária do documento) — fica em
     * `validarNovaSolicitacaoTrocaPlantao()` (lib/trocasPlantao.ts) e no
     * repositório, exatamente como `trocasEscala` também nunca validou o
     * campo `data` nas Rules.
     */
    match /trocasPlantao/{id} {
      allow get: if autenticado()
        && (
          resource.data.solicitanteLogin == loginDoAuth()
          || resource.data.destinatarioLogin == loginDoAuth()
          || souParticipanteAtivoDoGrupoPlantao(resource.data.grupoId)
          || podeAdministrarEscalaPlantao(resource.data.grupoId)
        );

      allow list: if autenticado()
        && (
          souParticipanteAtivoDoGrupoPlantao(resource.data.grupoId)
          || podeAdministrarEscalaPlantao(resource.data.grupoId)
        );

      // Autoatendimento: em nome próprio, para outro participante ATIVO do
      // MESMO Grupo, sempre em PENDENTE_USUARIO, histórico nascendo com
      // exatamente 1 evento.
      allow create: if autenticado()
        && request.resource.data.trocaId == id
        && request.resource.data.tipo == 'PLANTAO'
        && request.resource.data.status == 'PENDENTE_USUARIO'
        && request.resource.data.solicitanteLogin == loginDoAuth()
        && request.resource.data.criadoPorLogin == loginDoAuth()
        && request.resource.data.destinatarioLogin != loginDoAuth()
        && request.resource.data.grupoId is string && request.resource.data.grupoId.size() > 0
        && request.resource.data.plantaoSolicitanteId is string && request.resource.data.plantaoSolicitanteId.size() > 0
        && request.resource.data.plantaoDestinatarioId is string && request.resource.data.plantaoDestinatarioId.size() > 0
        && request.resource.data.plantaoSolicitanteId != request.resource.data.plantaoDestinatarioId
        && request.resource.data.historico.size() == 1
        && request.resource.data.gestorLogin == null
        && request.resource.data.motivoRecusa == null
        && souParticipanteAtivoDoGrupoPlantao(request.resource.data.grupoId)
        && participanteAtivoDoGrupoPlantao(request.resource.data.grupoId, request.resource.data.destinatarioLogin);

      allow update: if autenticado()
        && request.resource.data.historico.size() > resource.data.historico.size()
        && request.resource.data.grupoId == resource.data.grupoId
        && request.resource.data.solicitanteLogin == resource.data.solicitanteLogin
        && request.resource.data.destinatarioLogin == resource.data.destinatarioLogin
        && request.resource.data.plantaoSolicitanteId == resource.data.plantaoSolicitanteId
        && request.resource.data.plantaoDestinatarioId == resource.data.plantaoDestinatarioId
        && request.resource.data.criadoPorLogin == resource.data.criadoPorLogin
        && request.resource.data.criadoEm == resource.data.criadoEm
        && (
          (
            resource.data.destinatarioLogin == loginDoAuth()
            && resource.data.status == 'PENDENTE_USUARIO'
            && request.resource.data.status in ['RECUSADA_USUARIO', 'PENDENTE_GESTOR']
          )
          || (
            resource.data.solicitanteLogin == loginDoAuth()
            && resource.data.status == 'PENDENTE_USUARIO'
            && request.resource.data.status == 'CANCELADA'
          )
          // Aprovar/recusar é autorização OPERACIONAL do Grupo — nunca
          // "souGestor()" solto, nunca só pertencer a `equipesConsulta`.
          // `podeAdministrarEscalaPlantao()` já cobre, nesta ordem:
          // ADMIN_SISTEMA; responsável ativo na Matriz para tipo=PLANTAO e
          // alvoId=grupoId; fallback de ACL histórica só quando não existe
          // matriz; liberação de staging.
          || (
            podeAdministrarEscalaPlantao(resource.data.grupoId)
            && resource.data.status == 'PENDENTE_GESTOR'
            && request.resource.data.status in ['RECUSADA_GESTOR', 'APROVADA']
          )
        );

      // Mesmo critério de `trocasEscala`: só ADMIN_SISTEMA, para limpeza de
      // conta excluída. Nunca o gestor, nunca o solicitante.
      allow delete: if souAdminSistema();
    }

    /**
     * Notificações de troca de PLANTÃO — coleção dedicada, paralela a
     * `notificacoesTroca` (Jornada), pelo mesmo motivo da coleção de trocas
     * acima. Nada em `notificacoesTroca` muda nesta fase. Quem cria é
     * sempre quem executou a ação; `criadoPorLogin` autentica o autor sem
     * `get()` sobre `trocasPlantao` (a troca e a notificação são criadas no
     * mesmo lote, e `get()`/`exists()` em Rules não veem escritas
     * pendentes do próprio lote).
     */
    match /notificacoesTrocaPlantao/{id} {
      // Só o próprio destinatário — ou um admin de verdade, para limpeza de
      // conta removida. Igual `notificacoesTroca`: a checagem de admin em
      // `list` só passa se a consulta também filtrar por `grupoId`.
      allow read: if autenticado()
        && (
          resource.data.destinatarioLogin == loginDoAuth()
          || (resource.data.get('grupoId', null) != null && souAdminSistema())
        );

      allow create: if autenticado()
        && request.resource.data.criadoPorLogin == loginDoAuth()
        && request.resource.data.destinatarioLogin != loginDoAuth()
        && request.resource.data.lidaEm == null
        && request.resource.data.acao == 'ABRIR_TROCA_PLANTAO'
        && (
          // solicitante/destinatário avisando o outro lado (ou o gestor)
          souParticipanteAtivoDoGrupoPlantao(request.resource.data.grupoId)
          // gestor avisando as duas partes de uma decisão gerencial — pode
          // não ser participante do Grupo
          || (
            podeAdministrarEscalaPlantao(request.resource.data.grupoId)
            && request.resource.data.tipo in ['TROCA_PLANTAO_RECUSADA_GESTOR', 'TROCA_PLANTAO_APROVADA']
          )
        );

      allow update: if autenticado()
        && resource.data.destinatarioLogin == loginDoAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lidaEm']);

      allow delete: if souAdminSistema();
    }

    /**
     * Riscos conscientemente aceitos nesta fase (não são bugs esquecidos):
     *
     * - `LEITURA` (PerfilUsuario) hoje equivale exatamente a ANALISTA_SOC —
     *   nenhuma regra o restringe mais que isso; é um valor de enum
     *   reservado para o futuro, sem comportamento próprio ainda.
     * - Não existe caminho via rules para criar o primeiro ADMIN_SISTEMA
     *   (`create` em usuarios exige souAdminSistema() já verdadeiro — mesmo
     *   chicken-and-egg que o bootstrap do primeiro gestor sempre teve).
     *   Resolvido fora das rules: edição manual do documento no Console do
     *   Firestore (ver docs/operacao/BOOTSTRAP_ADMIN_STAGING.md).
     * - Reatribuir `equipeResponsavelId` de um Grupo já existente para outra equipe
     *   também não é possível nesta fase (campo imutável no `update`) —
     *   decisão aceita para não abrir uma via de transferência de poder
     *   administrativo sem revisão dedicada.
     * - FASE-TROCAS-PLANTAO-1: `trocasPlantao.create` não checa
     *   `gruposPlantao/{grupoId}.ativo` (só a existência do participante
     *   ativo) — um Grupo desativado com participantes ainda marcados como
     *   ativos aceitaria uma solicitação de troca. Aceito para não somar
     *   mais um `get()`/expressão à regra; desativar um Grupo já devia vir
     *   acompanhado de desativar seus participantes.
     */
  }
}
