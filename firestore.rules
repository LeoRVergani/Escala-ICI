rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    /**
     * O login corporativo é a chave funcional — derivado do e-mail
     * autenticado, do mesmo jeito que o app faz (fulano@empresa.com ->
     * fulano). Não depende de custom claims, de Admin SDK nem de
     * usuarios/{request.auth.uid}: funciona igual para login por senha hoje
     * e para um provedor OAuth corporativo (ex.: Microsoft) no futuro,
     * contanto que ele devolva e-mail.
     */
    function loginDoAuth() {
      return request.auth.token.email.lower().split('@')[0];
    }

    function eu() {
      return get(
        /databases/$(database)/documents/usuarios/$(loginDoAuth())
      ).data;
    }

    function minhaEquipe() {
      return eu().equipeId;
    }

    /**
     * Espelha `perfilEfetivo()` de lib/sessao.ts. `.get(chave, default)` é
     * obrigatório — acessar `usuarioDoc.perfil` direto em documento legado
     * sem o campo é erro de avaliação em Rules (não `null`), o que
     * reprovaria a expressão inteira para TODO usuário existente.
     */
    function perfilDe(usuarioDoc) {
      return usuarioDoc.get('perfil', null) != null
        ? usuarioDoc.perfil
        : (usuarioDoc.nivelHierarquico <= 5 ? 'GESTOR_EQUIPE' : 'ANALISTA_SOC');
    }

    function meuPerfil() {
      return perfilDe(eu());
    }

    function souAdminSistema() {
      return autenticado() && meuPerfil() == 'ADMIN_SISTEMA';
    }

    /**
     * Mantido com o mesmo nome para não obrigar reescrever toda regra que já
     * chama souGestor() — agora também é true para ADMIN_SISTEMA, que herda
     * todo poder de gestor mais o cross-equipe de podeOperarNaEquipe().
     */
    function souGestor() {
      return autenticado() && (meuPerfil() == 'GESTOR_EQUIPE' || souAdminSistema());
    }

    /**
     * Espelha `equipesPermitidasEfetivas()` de lib/sessao.ts: lista explícita
     * (não-vazia) manda; na ausência, `equipeId` (sempre presente) vira lista
     * implícita de 1 elemento — é o que mantém todo GESTOR_EQUIPE/
     * ANALISTA_SOC existente funcionando sem qualquer migração de dado, sem
     * precisar setar `equipesPermitidas` explicitamente.
     */
    function minhasEquipesPermitidas() {
      return eu().get('equipesPermitidas', []).size() > 0
        ? eu().equipesPermitidas
        : [eu().equipeId];
    }

    /**
     * Substitui toda comparação "X.equipeId == minhaEquipe()" espalhada pelo
     * arquivo: admin sempre passa, independente da equipe do documento;
     * qualquer outro perfil só passa se `equipeId` estiver em
     * `minhasEquipesPermitidas()` — que já cobre o caso de hoje (uma única
     * equipe, via fallback) e também um GESTOR_EQUIPE/SUPERVISOR_EQUIPE com
     * `equipesPermitidas` explícito cobrindo mais de uma equipe.
     */
    function podeOperarNaEquipe(equipeId) {
      return autenticado() && (souAdminSistema() || equipeId in minhasEquipesPermitidas());
    }

    /**
     * Espelha `unidadesPermitidasEfetivas()` de lib/sessao.ts: lista
     * explícita (não-vazia) manda; na ausência, `unidadeId` único vira lista
     * implícita de 1 elemento; sem nenhum dos dois, lista vazia. `.get(chave,
     * default)` é obrigatório pelo mesmo motivo de `perfilDe()` — documento
     * legado sem o campo não pode virar erro de avaliação.
     */
    function minhasUnidadesPermitidas() {
      return eu().get('unidadesPermitidas', []).size() > 0
        ? eu().unidadesPermitidas
        : (eu().get('unidadeId', null) != null ? [eu().unidadeId] : []);
    }

    function souGestorUnidade() {
      return autenticado() && meuPerfil() == 'GESTOR_UNIDADE';
    }

    /**
     * NÃO percorre `parentId`/árvore de unidades — só checa se `unidadeId`
     * está literalmente em `minhasUnidadesPermitidas()` (array explícito).
     * ADMIN_SISTEMA sempre passa.
     */
    function podeOperarNaUnidade(unidadeId) {
      return autenticado()
        && (souAdminSistema() || (souGestorUnidade() && unidadeId in minhasUnidadesPermitidas()));
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /usuarios/{login} {
      allow read: if autenticado()
        && (
          loginDoAuth() == login
          || podeOperarNaEquipe(resource.data.equipeId)
        );

      allow update: if autenticado()
        && (
          // autoatualização: só `nome`, como hoje — perfil/escopo nunca no
          // payload (nem para "reafirmar" o valor atual).
          (
            loginDoAuth() == login
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['nome'])
          )

          // admin: qualquer campo, qualquer equipe, inclusive perfil/escopo
          // e realocação de equipe — só `login` (o campo) fica imutável.
          || (
            souAdminSistema()
            && request.resource.data.login == resource.data.login
          )

          // gestor não-admin: exatamente como hoje (equipeId/login
          // imutáveis), MAIS a trava nova — não pode tocar perfil, escopo,
          // nem os campos do modelo organizacional flexível
          // (unidadeId/unidadesPermitidas/equipesPermitidas) de ninguém,
          // nem do próprio time.
          || (
            souGestor()
            && !souAdminSistema()
            && resource.data.equipeId == minhaEquipe()
            && request.resource.data.equipeId == resource.data.equipeId
            && request.resource.data.login == resource.data.login
            && request.resource.data.get('perfil', null) == resource.data.get('perfil', null)
            && request.resource.data.get('escopo', null) == resource.data.get('escopo', null)
            && request.resource.data.get('unidadeId', null) == resource.data.get('unidadeId', null)
            && request.resource.data.get('unidadesPermitidas', null) == resource.data.get('unidadesPermitidas', null)
            && request.resource.data.get('equipesPermitidas', null) == resource.data.get('equipesPermitidas', null)
          )
        );

      allow create: if autenticado()
        && request.resource.data.login == login
        && (
          // admin cria em qualquer equipe, com qualquer perfil/escopo/campo
          // organizacional — inclusive um novo ADMIN_SISTEMA.
          souAdminSistema()

          || (
            souGestor()
            && !souAdminSistema()
            && request.resource.data.equipeId == minhaEquipe()
            // gestor não-admin NUNCA pode setar perfil/escopo/campos
            // organizacionais na criação — nem um valor "inofensivo": o
            // campo tem que estar ausente do payload. Novo usuário cai no
            // fallback (perfilEfetivo/unidadesPermitidasEfetivas/
            // equipesPermitidasEfetivas), igual hoje.
            && request.resource.data.get('perfil', null) == null
            && request.resource.data.get('escopo', null) == null
            && request.resource.data.get('unidadeId', null) == null
            && request.resource.data.get('unidadesPermitidas', null) == null
            && request.resource.data.get('equipesPermitidas', null) == null
          )
        );

      allow delete: if souAdminSistema();
    }

    match /equipes/{equipeId} {
      allow read: if autenticado();
      // Antes: `if false` (nunca gravável via client, só seed server-side).
      // ADMIN_SISTEMA sempre pode, mesmo sem `unidadeId` (equipe legada,
      // sem unidade organizacional atribuída). GESTOR_UNIDADE só pode
      // criar/editar uma equipe cujo `unidadeId` esteja em
      // `podeOperarNaUnidade()` — o campo já vem no próprio documento
      // (`request.resource.data`/`resource.data`), então não é preciso
      // nenhum `get()` extra nem travessia de `parentId`.
      allow create: if souAdminSistema()
        || (request.resource.data.get('unidadeId', null) != null && podeOperarNaUnidade(request.resource.data.unidadeId));
      allow update: if souAdminSistema()
        || (resource.data.get('unidadeId', null) != null && podeOperarNaUnidade(resource.data.unidadeId));
      // Sem delete no MVP: nada no app hoje apaga equipe; desativar é
      // `ativa: false`. Dezenas de outras coleções referenciam o ID.
      allow delete: if false;
    }

    /**
     * Cadastro administrativo simples antigo — mantido intacto por
     * compatibilidade (não referenciado por `usuarios`/`equipes`/
     * `turnosMes`). A tela "Administração" do dashboard passou a usar
     * `unidadesOrganizacionais` para novos cadastros, mas `setores`
     * continua funcionando exatamente como antes.
     */
    match /setores/{setorId} {
      allow read: if autenticado();
      allow create, update: if souAdminSistema();
      allow delete: if false;
    }

    /**
     * Hierarquia organizacional flexível (qualquer nível acima de
     * `equipes`: diretoria, gerência, coordenação, supervisão...) —
     * coleção ADITIVA, não substitui `setores`/`equipes`.
     *
     * Delete sempre negado: nada apaga uma unidade que possa estar
     * referenciada por `equipes.unidadeId` ou por `unidadeId`/
     * `unidadesPermitidas` de algum usuário.
     *
     * NÃO percorre `parentId`: a checagem de "abaixo de uma unidade
     * permitida" olha só o `parentId` do PRÓPRIO documento sendo criado
     * (um único campo do payload, não uma travessia), contra o array
     * explícito `minhasUnidadesPermitidas()`.
     */
    match /unidadesOrganizacionais/{unidadeId} {
      allow read: if autenticado();

      allow create: if autenticado()
        && request.resource.data.unidadeId == unidadeId
        && request.resource.data.criadoPorLogin == loginDoAuth()
        && (
          souAdminSistema()
          || (request.resource.data.parentId != null && podeOperarNaUnidade(request.resource.data.parentId))
        );

      allow update: if autenticado()
        && request.resource.data.unidadeId == resource.data.unidadeId
        && podeOperarNaUnidade(unidadeId);

      allow delete: if false;
    }

    /**
     * Auditoria do modo simulação de gestor — um doc imutável por ação,
     * mesmo padrão de `historicoPublicacoes`. `atorRealLogin` sempre tem
     * que ser quem está de fato autenticado (nunca o ator simulado).
     */
    match /auditoriaAdmin/{id} {
      allow read: if souAdminSistema();
      allow create: if souAdminSistema()
        && request.resource.data.atorRealLogin == loginDoAuth();
      allow update, delete: if false;
    }

    match /tiposTurno/{docId} {
      allow read: if autenticado();
      allow write: if souGestor()
        && podeOperarNaEquipe(request.resource.data.equipeId);
    }

    match /turnosMes/{docId} {
      allow read: if autenticado()
        && podeOperarNaEquipe(resource.data.equipeId)
        && (
          resource.data.status == 'PUBLICADA'
          || souGestor()
        );

      allow create: if souGestor()
        && podeOperarNaEquipe(request.resource.data.equipeId)
        && request.resource.data.schemaVersion in [1]
        && request.resource.data.status == 'PUBLICADA';

      allow update: if souGestor()
        && podeOperarNaEquipe(resource.data.equipeId)
        && request.resource.data.equipeId == resource.data.equipeId
        && request.resource.data.login == resource.data.login
        && request.resource.data.schemaVersion in [1]
        && request.resource.data.status == 'PUBLICADA';

      allow delete: if souGestor()
        && podeOperarNaEquipe(resource.data.equipeId);
    }

    match /rascunhosTurnosMes/{docId} {
      allow read: if souGestor()
        && podeOperarNaEquipe(resource.data.equipeId);

      allow create, update: if souGestor()
        && podeOperarNaEquipe(request.resource.data.equipeId)
        && request.resource.data.schemaVersion in [1]
        && request.resource.data.status == 'RASCUNHO';

      allow delete: if souGestor()
        && podeOperarNaEquipe(resource.data.equipeId);
    }

    match /publicacoesEscala/{id} {
      allow read: if souGestor()
        && (
          resource == null
          || podeOperarNaEquipe(resource.data.equipeId)
        );
      allow create, update: if souGestor()
        && podeOperarNaEquipe(request.resource.data.equipeId);
      allow delete: if false;
    }

    match /historicoPublicacoes/{id} {
      allow read: if souGestor()
        && podeOperarNaEquipe(resource.data.equipeId);
      allow create: if souGestor()
        && podeOperarNaEquipe(request.resource.data.equipeId);
      allow update, delete: if false;
    }

    match /versoesEscala/{id} {
      allow read: if souGestor()
        && podeOperarNaEquipe(resource.data.equipeId);
      allow create: if souGestor()
        && podeOperarNaEquipe(request.resource.data.equipeId)
        && request.resource.data.status == 'PUBLICADA';
      allow update, delete: if false;
    }

    match /eventosEscala/{id} {
      allow read: if autenticado()
        && podeOperarNaEquipe(resource.data.equipeId)
        && (
          souGestor()
          || resource.data.usuarioUid == loginDoAuth()
        );
      allow create: if souGestor()
        && podeOperarNaEquipe(request.resource.data.equipeId)
        && request.resource.data.publicadoPor == loginDoAuth()
        && request.resource.data.alteracoes is list;
      allow update, delete: if false;
    }

    match /importacoes/{id} {
      // `read` sem filtro de equipe é pré-existente (nenhum código do app
      // hoje lê/lista `importacoes` — só escreve, em writeRepository.ts) e
      // fica assim de propósito: introduzir `resource.data.equipeId` num
      // `read` que cobre `list` reabriria o mesmo risco de erro de
      // avaliação que exigiu o hotfix de get/list separado em
      // `trocasEscala` (ver comentário abaixo), por um ganho prático nulo
      // hoje. `souGestor()` já cobre ADMIN_SISTEMA.
      allow read: if souGestor();
      allow create: if souGestor()
        && request.resource.data.enviadoPor == loginDoAuth()
        && podeOperarNaEquipe(request.resource.data.equipeId);
      allow update, delete: if false;
    }

    /**
     * Troca de escala (docs/spec/TROCA_ESCALA_PLANO.md) — primeira coleção
     * que o App do colaborador escreve, além de ler. Escopo de escrita
     * deliberadamente estreito: o App só cria a solicitação e move
     * PENDENTE_USUARIO -> {RECUSADA_USUARIO, PENDENTE_GESTOR,
     * CANCELADA_SOLICITANTE}; qualquer transição a partir de
     * PENDENTE_GESTOR é exclusividade do gestor. `historico` só pode
     * crescer (nunca é reescrito por trás).
     *
     * Hotfix 2 (permission-denied intermitente): `allow read` unificado com
     * a condição OR (souGestor() || solicitanteLogin==... ||
     * destinatarioLogin==...) falha de verdade no emulador — confirmado com
     * um teste isolado — quando um `list` (consulta com `where()`, exatamente
     * o que `observarTrocasDoGestor`/`observarTrocasDoUsuario` fazem) não
     * tem nenhum documento correspondente ao filtro do usuário atual mas EXISTE
     * algum documento de OUTRA equipe na coleção: o motor de regras avalia a
     * condição contra esse documento não relacionado e nega a consulta
     * inteira (`evaluation error ... false for 'list'`), não só o
     * documento — em vez de simplesmente devolver uma lista vazia. Separar
     * `get` (documento único, mantém a condição OR completa) de `list`
     * (consulta, condição simples só por equipe) resolve isso. Único efeito
     * colateral aceito: um colega comum passa a poder listar TODAS as
     * trocas da própria equipe (não só as suas) se montar a query sem o
     * filtro de papel — mesmo nível de exposição que `turnosMes` já tem
     * hoje (qualquer membro da equipe já lê a escala publicada de todo
     * colega, não só a própria).
     */
    match /trocasEscala/{id} {
      allow get: if autenticado()
        && podeOperarNaEquipe(resource.data.equipeId)
        && (
          souGestor()
          || resource.data.solicitanteLogin == loginDoAuth()
          || resource.data.destinatarioLogin == loginDoAuth()
        );

      allow list: if autenticado() && podeOperarNaEquipe(resource.data.equipeId);

      // Autoatendimento — quem cria age como membro da própria equipe, não
      // como admin cross-equipe. Deliberadamente não usa
      // podeOperarNaEquipe().
      allow create: if autenticado()
        && request.resource.data.equipeId == minhaEquipe()
        && request.resource.data.solicitanteLogin == loginDoAuth()
        && request.resource.data.destinatarioLogin != loginDoAuth()
        && request.resource.data.status == 'PENDENTE_USUARIO';

      allow update: if autenticado()
        && podeOperarNaEquipe(resource.data.equipeId)
        && request.resource.data.historico.size() > resource.data.historico.size()
        && (
          (
            resource.data.destinatarioLogin == loginDoAuth()
            && resource.data.status == 'PENDENTE_USUARIO'
            && request.resource.data.status in ['RECUSADA_USUARIO', 'PENDENTE_GESTOR']
          )
          || (
            resource.data.solicitanteLogin == loginDoAuth()
            && resource.data.status == 'PENDENTE_USUARIO'
            && request.resource.data.status == 'CANCELADA_SOLICITANTE'
          )
          || (
            souGestor()
            && resource.data.status == 'PENDENTE_GESTOR'
            && request.resource.data.status in ['RECUSADA_GESTOR', 'APROVADA_PUBLICADA']
          )
        );

      // Era `if false` — ADMIN_SISTEMA precisa poder apagar trocas
      // vinculadas a um usuário excluído (limpeza seletiva, ver
      // lib/firebase/adminRepository.ts).
      allow delete: if souAdminSistema();
    }

    /**
     * Notificações de troca — coleção nova e dedicada (não reaproveita
     * `eventosEscala`, que é só para publicação em massa). Quem cria é
     * sempre quem executou a ação (solicitante, destinatário ou gestor),
     * nunca o próprio destinatário da notificação; `criadoPorLogin`
     * autentica o autor sem depender de `get()` sobre `trocasEscala` (a
     * troca e a notificação são criadas no mesmo lote, e `get()`/`exists()`
     * em regras não veem escritas pendentes do mesmo lote).
     */
    match /notificacoesTroca/{id} {
      // Admin precisa enumerar (list/get) notificações de qualquer usuário
      // para poder excluir as vinculadas a uma conta removida — sem alargar
      // a exposição para o resto da equipe (diferente de `trocasEscala`
      // acima): só o próprio destinatário ou um admin de verdade.
      //
      // A checagem de admin só passa em `list` se a CONSULTA também filtrar
      // por `equipeId` — confirmado com teste isolado no emulador: uma
      // condição de `list` cujo campo não corresponde a nenhum `where()` da
      // consulta (ex.: checar `equipeId` numa query só com
      // `destinatarioLogin`) falha com "evaluation error" nesta coleção.
      // Por isso `excluirUsuario()` (lib/firebase/adminRepository.ts)
      // sempre inclui `where('equipeId', '==', ...)` além do filtro por
      // login.
      allow read: if autenticado()
        && (
          resource.data.destinatarioLogin == loginDoAuth()
          || (resource.data.get('equipeId', null) != null && souAdminSistema())
        );

      allow create: if autenticado()
        && request.resource.data.equipeId == minhaEquipe()
        && request.resource.data.criadoPorLogin == loginDoAuth()
        && request.resource.data.destinatarioLogin != loginDoAuth()
        && request.resource.data.lidaEm == null;

      allow update: if autenticado()
        && resource.data.destinatarioLogin == loginDoAuth()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lidaEm']);

      // Era `if false` — ADMIN_SISTEMA precisa poder apagar notificações
      // vinculadas a um usuário excluído.
      allow delete: if souAdminSistema();
    }

    /**
     * Dispositivos com Firebase Installation ID (FID) para push (Fase
     * Push-1B, ver apps/push-worker e CHECKPOINT-FASE-PUSH-1B-FID.md — a
     * Fase Push-1A original usava `token`, migrado sem compatibilidade
     * ativa). A chave é `deviceId`, não `login` — um usuário pode ter mais
     * de um aparelho (WEB e/ou ANDROID). O worker (Admin SDK) ignora estas
     * regras via IAM; elas só protegem o caminho do client SDK (PWA/app),
     * garantindo que cada usuário só veja/gerencie o próprio dispositivo,
     * com o `fid` sempre presente e nunca um campo `token` legado.
     */
    match /dispositivosPush/{deviceId} {
      // `resource == null` cobre a primeira ativação: `registrarOuRenovarDispositivo()`
      // sempre faz um `getDoc()` antes do `setDoc()` para decidir criar vs.
      // renovar, e nessa primeira chamada o documento ainda não existe —
      // sem esse curto-circuito, `resource.data.login` avalia contra um
      // `resource` nulo e o Firestore nega o `get` com erro de avaliação
      // antes mesmo do cliente chegar ao `create`. Documento existente
      // continua exigindo o mesmo login do dono.
      allow get: if autenticado() && (resource == null || resource.data.login == loginDoAuth());

      // Sem `list`: o client só precisa checar/atualizar o próprio
      // dispositivo, cujo id ele já conhece — nunca enumerar dispositivos
      // de outra pessoa. O FID nunca fica listável por terceiros.
      allow list: if false;

      allow create: if autenticado()
        && request.resource.data.login == loginDoAuth()
        && request.resource.data.deviceId == deviceId
        && request.resource.data.fid is string
        && request.resource.data.fid.size() > 0
        && request.resource.data.plataforma in ['WEB', 'ANDROID']
        && request.resource.data.ativo is bool
        && request.resource.data.environment == 'STAGING'
        && request.resource.data.schemaVersion in [1]
        && !('token' in request.resource.data)
        && request.resource.data.keys().hasOnly([
          'deviceId', 'login', 'plataforma', 'fid', 'ativo',
          'criadoEm', 'atualizadoEm', 'ultimaConfirmacaoEm', 'appVersion',
          'environment', 'schemaVersion',
        ]);

      // `login`/`deviceId`/`environment` imutáveis; `fid` pode ser
      // renovado (é exatamente o caso de uso — o FID muda com o tempo);
      // `ativo`/timestamps/`plataforma`/`appVersion`/`schemaVersion` podem
      // ser atualizados. Nunca aceita reintroduzir `token`.
      allow update: if autenticado()
        && resource.data.login == loginDoAuth()
        && request.resource.data.login == resource.data.login
        && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.environment == resource.data.environment
        && request.resource.data.fid is string
        && request.resource.data.fid.size() > 0
        && request.resource.data.plataforma in ['WEB', 'ANDROID']
        && request.resource.data.ativo is bool
        && !('token' in request.resource.data)
        && request.resource.data.keys().hasOnly([
          'deviceId', 'login', 'plataforma', 'fid', 'ativo',
          'criadoEm', 'atualizadoEm', 'ultimaConfirmacaoEm', 'appVersion',
          'environment', 'schemaVersion',
        ]);

      allow delete: if autenticado() && resource.data.login == loginDoAuth();
    }

    /**
     * Controle técnico de idempotência/entrega do push-worker (Fase
     * Push-1). Zero acesso via client SDK, propositalmente — só o Admin
     * SDK, autenticado por IAM, lê/escreve aqui. Nunca "abrir" esta coleção
     * para facilitar o worker: Admin SDK não depende de Security Rules.
     */
    match /pushEntregas/{notificacaoId} {
      allow read, write: if false;
    }

    /**
     * Riscos conscientemente aceitos nesta fase (não são bugs esquecidos):
     *
     * - `LEITURA` (PerfilUsuario) hoje equivale exatamente a ANALISTA_SOC —
     *   nenhuma regra o restringe mais que isso; é um valor de enum
     *   reservado para o futuro, sem comportamento próprio ainda.
     * - Não existe caminho via rules para criar o primeiro ADMIN_SISTEMA
     *   (`create` em usuarios exige souAdminSistema() já verdadeiro — mesmo
     *   chicken-and-egg que o bootstrap do primeiro gestor sempre teve).
     *   Resolvido fora das rules: edição manual do documento no Console do
     *   Firestore (ver docs/operacao/BOOTSTRAP_ADMIN_STAGING.md).
     */
  }
}
