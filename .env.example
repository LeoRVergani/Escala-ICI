# Firebase Web SDK (mesmos valores podem ser usados pelos dois SPAs)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Ambiente operacional. Fora do laboratório, a aplicação só aceita escrita
# quando o valor é staging e o project ID termina em -staging/-hml/-homolog.
VITE_FIREBASE_ENVIRONMENT=

# Segurança operacional: mantenha false por padrão.
# O laboratório local usa .env.emulator e não precisa habilitar escrita oficial.
# Habilite true somente em um build administrativo futuro formalmente aprovado.
VITE_ALLOW_OFFICIAL_FIRESTORE_WRITE=false

# Emuladores. LAN exige modo explícito, ambiente local e IPv4 privado exato.
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_LAN_MODE=false
VITE_FIREBASE_LAN_HOST=
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080

# URLs cruzadas quando Dashboard e App forem hospedados separadamente.
# No Docker, VITE_EMPLOYEE_APP_URL alimenta a ação "Abrir app" do Dashboard.
# Em desenvolvimento, use as portas padrão abaixo.
VITE_DASHBOARD_URL=http://localhost:4173
VITE_EMPLOYEE_APP_URL=http://localhost:4174
