# Copie para .env.staging.push-worker e ajuste. Este arquivo real permanece
# ignorado pelo Git. Nunca coloque a credencial (JSON da service account)
# aqui — ela chega ao container via Docker secret
# (/opt/escala-ici/secrets/escala-ici-staging-push-worker.json), nunca por
# variável de ambiente.

# Kill switch — mantenha "false" até validar toda a infraestrutura com
# `npm run check --workspace @escala-ici/push-worker` e
# `npm run push:test --workspace @escala-ici/push-worker -- --login=<login>`.
PUSH_ENABLED=false

# Corte de ativação (ISO 8601). Notificações com criadoEm anterior a este
# timestamp são ignoradas — evita reenviar dezenas de notificações antigas
# no primeiro start. Definir uma vez e manter estável depois da ativação.
PUSH_ACTIVATED_AT=2026-01-01T00:00:00.000Z
