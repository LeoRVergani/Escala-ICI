# Laboratório LAN com dados totalmente fictícios.
# Copie apenas se for iniciar os serviços manualmente. O launcher Linux define
# estes valores automaticamente a partir de --host.
VITE_FIREBASE_API_KEY=AIza00000000000000000000000000000000000
VITE_FIREBASE_AUTH_DOMAIN=demo-escala-ici-fase3i.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-escala-ici-fase3i
