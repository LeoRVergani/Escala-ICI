# Copie para .env.staging.app e preencha somente com o Firebase Web App
# fictício de homologação. Nunca use dados ou credenciais de produção.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=SEU-PROJETO-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=SEU-PROJETO-staging
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_ENVIRONMENT=staging
VITE_ALLOW_OFFICIAL_FIRESTORE_WRITE=false
VITE_FIREBASE_USE_EMULATORS=false
FIREBASE_STAGING_CONFIRMATION=ESCALA_ICI_STAGING_ONLY

# Fase PUSH-PWA-1 — registro FID (Firebase Cloud Messaging). Sem estes dois
# valores, o App continua funcionando normalmente (login, escala, Trocas);
# só o card "Notificações" do Perfil fica em NAO_CONFIGURADO. Nunca
# preencha com valores reais aqui — este arquivo é o `.example` versionado.
# Sender ID do mesmo Firebase Web App já configurado acima.
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Chave pública VAPID (Console Firebase > Cloud Messaging > Web Push
# certificates). É pública por natureza, mas ainda assim não deve ser
# commitada — vem só do ambiente real (Cloudflare Pages em staging).
VITE_FIREBASE_VAPID_KEY=

VITE_DASHBOARD_URL=https://dashboard-staging.exemplo.local
CLOUDFLARE_PAGES_PROJECT=escala-ici-app-staging
